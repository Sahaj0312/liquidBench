{%- assign heading = section.settings.heading | strip -%}
<section class="how-it-works">
  {%- if heading != "" -%}
  <h2>{{ heading | escape }}</h2>
  {%- endif -%}
  <ol>
  {%- for block in section.blocks -%}
    {%- assign title = block.settings.title | strip -%}
    {%- assign text = block.settings.text | strip -%}
    {%- if title != "" -%}
    <li><h3>{{ title | escape }}</h3>
    {%- if text != "" -%}<p>{{ text | escape }}</p>{%- endif -%}
    </li>
    {%- endif -%}
  {%- endfor -%}
  </ol>
</section>
{%- comment -%} Step list for the how-it-works banner. {%- endcomment -%}
{% schema %}
{"name":"How it works","settings":[{"type":"text","id":"heading","label":"Heading"}],"blocks":[{"type":"step","name":"Step","settings":[{"type":"text","id":"title","label":"Title"},{"type":"textarea","id":"text","label":"Text"}]}],"presets":[{"name":"How it works"}]}
{% endschema %}
