{%- comment -%} Product reviews: lists reviews, accumulates rating and verified count, loads the script once. {%- endcomment -%}
{%- liquid
  assign rating_total = 0
  assign verified_count = 0
  assign script_loaded = false
  assign heading = 'product.reviews.heading' | t
  assign verified_label = 'products.reviews.verified_buyer' | t
  assign empty_label = 'products.review.empty' | t
-%}
{{ 'product-reviews.css' | asset_url | stylesheet_tag }}
<section class="product-reviews">
  <h2 class="product-reviews__heading">{{ heading }}</h2>
  {%- for review in reviews -%}
    {%- assign rating_total = rating_total | plus: review.rating -%}
    {%- if review.verified -%}
      {%- assign verified_count = verified_count | plus: 1 -%}
    {%- endif -%}
    {%- unless script_loaded -%}
      <script src="{{ 'reviews.js' | asset_url }}" defer="defer"></script>
      {%- assign script_loaded = true -%}
    {%- endunless -%}
    {%- render 'reviews-card', review: review, position: forloop.index, verified_label: verified_label -%}
  {%- else -%}
    <p class="product-reviews__empty">{{ empty_label }}</p>
  {%- endfor -%}
  {%- if reviews.size > 0 -%}
    {%- assign average = rating_total | times: 1.0 | divided_by: reviews.size | round: 1 -%}
    {%- render 'review-star', rating: average, verified_count: verified_count -%}
  {%- endif -%}
</section>
