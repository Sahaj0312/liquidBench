<section class="press-mentions">
  {%- assign heading = section.settings.heading | strip -%}
  {%- if heading != "" -%}
    <h2 class="press-mentions__heading">{{ heading | escape }}</h2>
  {%- endif -%}
  <ul class="press-mentions__list">
    {%- for block in section.blocks -%}
      <li class="press-mentions__item"><blockquote>{{ block.settings.quote | escape }}</blockquote><cite>{{ block.settings.outlet | escape }}</cite></li>
    {%- endfor -%}
  </ul>
</section>
{% schema %}
{
  "name": "Press mentions",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "As seen in" }
  ],
  "blocks": [
    {
      "type": "mention",
      "name": "Mention",
      "settings": [
        { "type": "text", "id": "outlet", "label": "Outlet" },
        { "type": "textarea", "id": "quote", "label": "Quote" },
        { "type": "number", "id": "score", "label": "Review score (0-100)" }
      ]
    }
  ],
  "presets": [{ "name": "Press mentions" }]
}
{% endschema %}
