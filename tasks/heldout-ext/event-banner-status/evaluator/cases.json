    "id": "contract",
    "path": "sections/event-banner-status.liquid",
    "tags": [
      "a",
      "h2",
      "section",
      "span"
    ],
    "schema_block": "{% schema %}\n{\n  \"name\": \"Event banner\",\n  \"settings\": [\n    { \"type\": \"text\", \"id\": \"title\", \"label\": \"Title\" },\n    { \"type\": \"checkbox\", \"id\": \"is_cancelled\", \"label\": \"Event cancelled\", \"default\": false },\n    { \"type\": \"checkbox\", \"id\": \"is_sold_out\", \"label\": \"Sold out\", \"default\": false },\n    { \"type\": \"number\", \"id\": \"days_until\", \"label\": \"Days until event\" },\n    { \"type\": \"text\", \"id\": \"button_label\", \"label\": \"Button label\" },\n    { \"type\": \"url\", \"id\": \"button_link\", \"label\": \"Button link\" }\n  ],\n  \"presets\": [{ \"name\": \"Event banner\" }]\n}\n{% endschema %}"
  },
