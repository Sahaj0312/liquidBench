{%- liquid
  assign heading = section.settings.heading | strip
  assign subheading = section.settings.subheading | strip
  assign visible_count = 0
  for block in section.blocks
    assign label = block.settings.label | strip
    if label != ''
      assign visible_count = visible_count | plus: 1
    endif
  endfor
  if visible_count > 4
    assign visible_count = 4
  endif
-%}
{%- if heading != '' or subheading != '' or visible_count > 0 -%}
<div class="trust-badges{% if section.settings.show_border %} trust-badges--bordered{% endif %}">
  {%- if heading != '' or subheading != '' -%}
    <header class="trust-badges__header">
      {%- if heading != '' -%}<h2>{{ heading | escape }}</h2>{%- endif -%}
      {%- if subheading != '' -%}<p>{{ subheading | escape }}</p>{%- endif -%}
    </header>
  {%- endif -%}
  {%- if visible_count > 0 -%}
    {%- assign shown = 0 -%}
    <ul class="trust-badges__list" data-count="{{ visible_count }}">
      {%- for block in section.blocks -%}
        {%- assign label = block.settings.label | strip -%}
        {%- if label != '' and shown < 4 -%}
          {%- assign shown = shown | plus: 1 -%}
          {%- assign url = block.settings.url | strip -%}
          <li class="trust-badge">
            {%- if url != '' -%}
              <a href="{{ url | escape }}">{{ label | escape }}</a>
            {%- else -%}
              <span>{{ label | escape }}</span>
            {%- endif -%}
          </li>
        {%- endif -%}
      {%- endfor -%}
    </ul>
  {%- endif -%}
</div>
{%- endif -%}

{% schema %}
{
  "name": "Trust badges",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "text", "id": "subheading", "label": "Subheading" },
    { "type": "checkbox", "id": "show_border", "label": "Show border", "default": false }
  ],
  "blocks": [
    {
      "type": "badge",
      "name": "Badge",
      "settings": [
        { "type": "text", "id": "label", "label": "Label" },
        { "type": "url", "id": "url", "label": "Link" }
      ]
    }
  ],
  "presets": [{ "name": "Trust badges" }]
}
{% endschema %}
