<section class="milestones">
  {%- if section.settings.heading != nil and section.settings.heading != "" -%}
    <h2>{{ section.settings.heading | escape }}</h2>
  {%- endif -%}
  <ol>
    {%- for block in section.blocks limit: section.settings.max_items -%}
      {%- if block.settings.title != nil and block.settings.title != "" -%}
        <li><span class="year">{{ block.settings.year | escape }}</span> {{ block.settings.title | escape }}</li>
      {%- endif -%}
    {%- endfor -%}
  </ol>
</section>
{% schema %}
{
  "name": "Milestones timeline",
  "settings": [
    {"type": "text", "id": "heading", "label": "Heading", "default": "Our story"},
    {"type": "range", "id": "max_items", "label": "Maximum milestones", "min": 1, "max": 10, "step": 1, "default": 5}
  ],
  "blocks": [
    {"type": "milestone", "name": "Milestone", "settings": [
      {"type": "text", "id": "year", "label": "Year"},
      {"type": "text", "id": "title", "label": "Title"}
    ]}
  ],
  "presets": [{"name": "Milestones timeline"}]
}
{% endschema %}
