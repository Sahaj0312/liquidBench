{%- assign heading = section.settings.heading | default: '' -%}
<section class="award-list">
{%- if heading != '' -%}<h2 class="award-list__heading">{{ heading | escape }}</h2>{%- endif -%}
<ul class="award-list__items">
{%- for block in section.blocks -%}
<li class="award-list__item"><span class="award-list__name">{{ block.settings.name | escape }}</span>
{%- if block.settings.year != nil -%}<span class="award-list__year">{{ block.settings.year }}</span>{%- endif -%}
</li>
{%- endfor -%}
</ul></section>
{%- comment -%} Blocks and settings are defined in the schema below. {%- endcomment -%}
{% schema %}
{
  "name": "Award list",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Awards" }
  ],
  "blocks": [
    {
      "type": "award",
      "name": "Award",
      "settings": [
        { "type": "text", "id": "name", "label": "Award name" },
        { "type": "number", "id": "year", "label": "Year" }
      ]
    }
  ],
  "presets": [{ "name": "Award list" }]
}
{% endschema %}