{%- assign heading = section.settings.heading | default: '' -%}
{%- assign valid_count = 0 -%}
{%- for block in section.blocks -%}
  {%- assign award_name = block.settings.name | default: '' | strip -%}
  {%- if award_name != '' -%}
    {%- assign valid_count = valid_count | plus: 1 -%}
  {%- endif -%}
{%- endfor -%}
{%- if valid_count > 0 -%}
<section class="award-list">
{%- if heading != '' -%}<h2 class="award-list__heading">{{ heading | escape }}</h2>{%- endif -%}
<ul class="award-list__items">
{%- assign position = 0 -%}
{%- for block in section.blocks -%}
  {%- assign award_name = block.settings.name | default: '' | strip -%}
  {%- if award_name != '' -%}
    {%- assign position = position | plus: 1 -%}
    {%- assign item_class = 'award-list__item' -%}
    {%- if position == 1 -%}
      {%- assign item_class = item_class | append: ' award-list__item--first' -%}
    {%- endif -%}
    {%- if position == valid_count -%}
      {%- assign item_class = item_class | append: ' award-list__item--last' -%}
    {%- endif -%}
<li class="{{ item_class }}">
{%- if position == 1 and valid_count > 1 -%}<strong class="award-list__latest">Latest</strong>{%- endif -%}
<span class="award-list__name">{{ award_name | escape }}</span>
{%- if block.settings.year != nil -%}<span class="award-list__year">{{ block.settings.year }}</span>{%- endif -%}
</li>
  {%- endif -%}
{%- endfor -%}
</ul></section>
{%- endif -%}
{%- comment -%} Blocks and settings are defined in the schema below. {%- endcomment -%}
{% schema %}
{
  "name": "Award list",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Awards" }
  ],
  "blocks": [
    {
      "type": "award",
      "name": "Award",
      "settings": [
        { "type": "text", "id": "name", "label": "Award name" },
        { "type": "number", "id": "year", "label": "Year" }
      ]
    }
  ],
  "presets": [{ "name": "Award list" }]
}
{% endschema %}