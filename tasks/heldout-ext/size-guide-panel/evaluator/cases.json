  {
    "id": "schema-contract",
    "path": "sections/size-guide-panel.liquid",
    "body": "{%- assign s = section.settings -%}\n<div class=\"size-guide\">\n  {%- if s.heading != blank -%}\n    <h2 class=\"size-guide__heading\">{{ s.heading | escape }}</h2>\n  {%- endif -%}\n  {%- if s.show_wrapper -%}<{{ s.wrapper_tag }} class=\"size-guide__panel\">{%- endif -%}\n  <table class=\"size-guide__table\">\n    {%- for block in section.blocks -%}\n      <tr {{ block.shopify_attributes }}>\n        <th scope=\"row\">{{ block.settings.label | escape }}</th>\n        <td>{{ block.settings.chest | escape }}</td>\n        <td>{{ block.settings.waist | escape }}</td>\n      </tr>\n    {%- endfor -%}\n  </table>\n  {%- if s.show_wrapper -%}</{{ s.wrapper_tag }}>{%- endif -%}\n  {%- if s.note != blank -%}\n    <div class=\"size-guide__note\">{{ s.note }}</div>\n  {%- endif -%}\n</div>\n\n\n",
    "expected": {
