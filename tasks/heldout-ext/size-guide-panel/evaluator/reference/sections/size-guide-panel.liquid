{%- assign s = section.settings -%}
<div class="size-guide">
  {%- if s.heading != blank -%}
    <h2 class="size-guide__heading">{{ s.heading | escape }}</h2>
  {%- endif -%}
  {%- if s.show_wrapper -%}<{{ s.wrapper_tag }} class="size-guide__panel">{%- endif -%}
  <table class="size-guide__table">
    {%- for block in section.blocks -%}
      <tr {{ block.shopify_attributes }}>
        <th scope="row">{{ block.settings.label | escape }}</th>
        <td>{{ block.settings.chest | escape }}</td>
        <td>{{ block.settings.waist | escape }}</td>
      </tr>
    {%- endfor -%}
  </table>
  {%- if s.show_wrapper -%}</{{ s.wrapper_tag }}>{%- endif -%}
  {%- if s.note != blank -%}
    <div class="size-guide__note">{{ s.note }}</div>
  {%- endif -%}
</div>

{% schema %}
{"name":"Size guide","tag":"aside","class":"section-size-guide","settings":[{"type":"header","content":"Layout"},{"type":"checkbox","id":"show_wrapper","label":"Wrap table in panel","default":true},{"type":"select","id":"wrapper_tag","label":"Panel element","options":[{"value":"div","label":"Div"},{"value":"section","label":"Section"},{"value":"figure","label":"Figure"}],"default":"div"},{"type":"header","content":"Content"},{"type":"text","id":"heading","label":"Heading","default":"Size guide"},{"type":"richtext","id":"note","label":"Fit note"}],"blocks":[{"type":"size_row","name":"Size row","settings":[{"type":"text","id":"label","label":"Size label","default":"M"},{"type":"text","id":"chest","label":"Chest"},{"type":"text","id":"waist","label":"Waist"}]}],"max_blocks":12,"presets":[{"name":"Size guide","blocks":[{"type":"size_row","settings":{"label":"S"}},{"type":"size_row","settings":{"label":"M"}},{"type":"size_row","settings":{"label":"L"}}]}]}
{% endschema %}
