{%- assign sep = section.settings.separator | default: ", " -%}
<div class="lookbook">
  {%- if section.settings.heading != blank -%}
    <h2>{{ section.settings.heading | escape }}</h2>
  {%- endif -%}
  {%- for block in section.blocks -%}
    {%- assign tag_list = block.settings.tags | split: "," -%}
    <figure {{ block.shopify_attributes }}>
      <figcaption>{{ block.settings.title | escape }}{% if tag_list.size > 0 %}: {{ tag_list | join: sep | escape }}{% endif %}</figcaption>
    </figure>
  {%- endfor -%}
</div>

{% schema %}
{
  "name": "Lookbook",
  "settings": [
    {"type": "text", "id": "heading", "label": "Heading"},
    {"type": "text", "id": "separator", "label": "Separator", "default": ","}
  ],
  "blocks": [
    {
      "type": "look",
      "name": "Look",
      "settings": [
        {"type": "text", "id": "title", "label": "Title"},
        {"type": "textarea", "id": "tags", "label": "Tags"}
      ]
    }
  ]
}
{% endschema %}
