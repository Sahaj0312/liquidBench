[
  {
    "id": "schema-contract",
    "path": "sections/lookbook-tag-strip.liquid",
    "body": "{%- assign sep = section.settings.separator | default: \", \" -%}\n<div class=\"lookbook\">\n  {%- if section.settings.heading != blank -%}\n    <h2>{{ section.settings.heading | escape }}</h2>\n  {%- endif -%}\n  {%- for block in section.blocks -%}\n    {%- assign tag_list = block.settings.tags | split: \",\" -%}\n    <figure {{ block.shopify_attributes }}>\n      <figcaption>{{ block.settings.title | escape }}{% if tag_list.size > 0 %}: {{ tag_list | join: sep | escape }}{% endif %}</figcaption>\n    </figure>\n  {%- endfor -%}\n</div>\n\n\n",
    "expected": {
      "name": "Lookbook",
      "tag": "section",
      "max_blocks": 6,
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Lookbook"
        },
        {
          "type": "select",
          "id": "separator",
          "label": "Tag separator",
          "options": [
            {
              "value": ", ",
              "label": "Comma"
            },
            {
              "value": " / ",
              "label": "Slash"
            },
            {
              "value": " | ",
              "label": "Pipe"
            }
          ],
          "default": " / "
        }
      ],
      "blocks": [
        {
          "type": "look",
          "name": "Look",
          "settings": [
            {
              "type": "text",
              "id": "title",
              "label": "Title",
              "default": "Look"
            },
            {
              "type": "text",
              "id": "tags",
              "label": "Tags",
              "info": "Separate tags with commas"
            }
          ]
        }
      ],
      "presets": [
        {
          "name": "Lookbook",
          "blocks": [
            {
              "type": "look"
            },
            {
              "type": "look"
            },
            {
              "type": "look"
            }
          ]
        }
      ]
    }
  }
