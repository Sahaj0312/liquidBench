{%- liquid
  assign heading = section.settings.heading | strip
  if heading == ''
    assign heading = 'Shop the look'
  endif
  assign columns = section.settings.columns | default: 3 | at_least: 2 | at_most: 4
  assign look_count = 0
-%}
{%- capture looks_html -%}
  {%- for block in section.blocks -%}
    {%- assign image = block.settings.image | strip -%}
    {%- if image != '' -%}
      {%- assign look_count = look_count | plus: 1 -%}
      {%- assign caption = block.settings.caption | strip -%}
      {%- if caption == '' -%}
        {%- assign caption = 'Look ' | append: look_count -%}
      {%- endif -%}
      <li class="lookbook__item" data-index="{{ look_count }}"><figure data-image="{{ image | escape }}"><figcaption>{{ caption | escape }}</figcaption></figure></li>
    {%- endif -%}
  {%- endfor -%}
{%- endcapture -%}
<section class="lookbook"><h2 class="lookbook__heading">{{ heading | escape }}</h2>{%- if look_count == 0 -%}<p class="lookbook__empty">No looks yet</p>{%- else -%}<ul class="lookbook__grid lookbook__grid--{{ columns }}">{{ looks_html }}</ul>{%- endif -%}</section>
{% schema %}
{"name":"Lookbook grid","settings":[{"type":"text","id":"heading","label":"Heading","default":"Shop the look"},{"type":"range","id":"columns","label":"Columns","min":2,"max":4,"step":1,"default":3}],"blocks":[{"type":"look","name":"Look","settings":[{"type":"text","id":"image","label":"Image URL"},{"type":"text","id":"caption","label":"Caption"}]}],"presets":[{"name":"Lookbook grid"}]}
{% endschema %}
