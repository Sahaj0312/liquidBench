[
  {
    "id": "schema-contract",
    "path": "sections/social-feed-section.liquid",
    "body": "<div class=\"social-feed\">\n  {%- if section.settings.heading != blank -%}\n    <h2 class=\"social-feed__heading\">{{ section.settings.heading | escape }}</h2>\n  {%- endif -%}\n  {%- if section.settings.profile_url != blank -%}\n    <a class=\"social-feed__handle\" href=\"{{ section.settings.profile_url | escape }}\"{% if section.settings.open_in_new_tab %} target=\"_blank\" rel=\"noopener\"{% endif %}>{{ section.settings.handle | escape }}</a>\n  {%- endif -%}\n  <ul class=\"social-feed__grid\">\n    {%- for block in section.blocks -%}\n      <li class=\"social-feed__post\" {{ block.shopify_attributes }}>\n        <a href=\"{{ block.settings.link | escape }}\" title=\"{{ block.settings.caption | escape }}\">\n          <p class=\"social-feed__caption\">{{ block.settings.caption | escape }}</p>\n        </a>\n      </li>\n    {%- endfor -%}\n  </ul>\n</div>\n\n",
    "expected": {
      "name": "Social feed",
      "tag": "section",
      "class": "section-social-feed",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Follow us"
        },
        {
          "type": "text",
          "id": "handle",
          "label": "Account handle",
          "default": "@ourstore"
        },
        {
          "type": "url",
          "id": "profile_url",
          "label": "Profile link"
        },
        {
          "type": "checkbox",
          "id": "open_in_new_tab",
          "label": "Open profile in new tab",
          "default": true
        }
      ],
      "blocks": [
        {
          "type": "post",
          "name": "Post",
          "settings": [
            {
              "type": "textarea",
              "id": "caption",
              "label": "Caption",
              "default": "Fresh drops & behind-the-scenes <3"
            },
            {
              "type": "url",
              "id": "link",
              "label": "Post link"
            }
          ]
        }
      ],
      "max_blocks": 8,
      "presets": [
        {
          "name": "Social feed",
          "blocks": [
            {
              "type": "post"
            },
            {
              "type": "post"
            }
          ]
        }
      ]
    }
  }
]
