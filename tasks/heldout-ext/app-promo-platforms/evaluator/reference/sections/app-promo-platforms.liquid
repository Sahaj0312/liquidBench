{%- liquid
  assign platform = section.settings.platform
  unless platform == 'ios' or platform == 'android' or platform == 'all'
    assign platform = 'all'
  endunless
  assign heading = section.settings.heading | strip
  assign ios_url = section.settings.ios_url | strip
  assign android_url = section.settings.android_url | strip
  assign feature_count = 0
  for block in section.blocks
    assign text = block.settings.text | strip
    assign tokens = block.settings.platforms | split: ','
    if text != ''
      if platform == 'all' or tokens contains platform or tokens contains 'all'
        assign feature_count = feature_count | plus: 1
      endif
    endif
  endfor
  assign show_ios = false
  assign show_android = false
  if platform == 'ios' or platform == 'all'
    if ios_url != ''
      assign show_ios = true
    endif
  endif
  if platform == 'android' or platform == 'all'
    if android_url != ''
      assign show_android = true
    endif
  endif
-%}
<div class="app-promo" data-platform="{{ platform }}">
  {%- if heading != '' -%}<h2>{{ heading | escape }}</h2>{%- endif -%}
  {%- if feature_count > 0 -%}
    <ul class="app-promo__features">
      {%- for block in section.blocks -%}
        {%- assign text = block.settings.text | strip -%}
        {%- assign tokens = block.settings.platforms | split: ',' -%}
        {%- if text != '' -%}
          {%- if platform == 'all' or tokens contains platform or tokens contains 'all' -%}
            <li>{{ text | escape }}</li>
          {%- endif -%}
        {%- endif -%}
      {%- endfor -%}
    </ul>
  {%- endif -%}
  {%- if show_ios or show_android -%}
    <div class="app-promo__stores">
      {%- if show_ios -%}
        <a class="app-promo__store app-promo__store--ios" href="{{ ios_url | escape }}">App Store</a>
      {%- endif -%}
      {%- if show_android -%}
        <a class="app-promo__store app-promo__store--android" href="{{ android_url | escape }}">Google Play</a>
      {%- endif -%}
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "App promo",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading" },
    {
      "type": "select",
      "id": "platform",
      "label": "Platform",
      "options": [
        { "value": "all", "label": "All" },
        { "value": "ios", "label": "iOS" },
        { "value": "android", "label": "Android" }
      ],
      "default": "all"
    },
    { "type": "url", "id": "ios_url", "label": "App Store URL" },
    { "type": "url", "id": "android_url", "label": "Google Play URL" }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "settings": [
        { "type": "text", "id": "text", "label": "Text" },
        { "type": "text", "id": "platforms", "label": "Platforms (comma-separated)" }
      ]
    }
  ],
  "presets": [{ "name": "App promo" }]
}
{% endschema %}
