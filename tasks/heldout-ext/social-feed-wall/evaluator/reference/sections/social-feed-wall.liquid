{%- assign handles = section.settings.handles | split: ',' -%}
<section class="social-feed">
  {%- if section.settings.heading != blank -%}
    <h2 class="social-feed__heading">{{ section.settings.heading | escape }}</h2>
  {%- endif -%}
  {%- if handles.size > 0 -%}
    <p class="social-feed__handles">{{ handles | join: section.settings.separator | escape }}</p>
  {%- endif -%}
  <ul class="social-feed__posts">
    {%- for block in section.blocks limit: section.settings.post_limit -%}
      <li class="social-feed__post" {{ block.shopify_attributes }}>
        {%- if block.settings.link != blank -%}<a href="{{ block.settings.link }}">{%- endif -%}
        <span>{{ block.settings.caption | escape }}</span>
        {%- if block.settings.link != blank -%}</a>{%- endif -%}
        <small>{{ block.settings.tags | split: ',' | join: ' · ' | escape }}</small>
      </li>
    {%- endfor -%}
  </ul>
</section>

{% schema %}
{
  "name": "Social feed",
  "tag": "section",
  "class": "social-feed-section",
  "settings": [
    {"type": "text", "id": "heading", "label": "Heading", "default": "Follow us"},
    {"type": "textarea", "id": "handles", "label": "Handles", "info": "Comma-separated"},
    {"type": "select", "id": "separator", "label": "Separator", "options": [
      {"value": " · ", "label": "Dot"},
      {"value": " | ", "label": "Pipe"},
      {"value": ", ", "label": "Comma"}
    ], "default": " · "},
    {"type": "range", "id": "post_limit", "label": "Posts to show", "min": 2, "max": 12, "step": 1, "default": 6}
  ],
  "blocks": [
    {"type": "post", "name": "Post", "settings": [
      {"type": "text", "id": "caption", "label": "Caption"},
      {"type": "text", "id": "tags", "label": "Tags"},
      {"type": "url", "id": "link", "label": "Link"}
    ]}
  ],
  "max_blocks": 12,
  "presets": [
    {"name": "Social feed", "blocks": [{"type": "post"}, {"type": "post"}]}
  ]
}
{% endschema %}
