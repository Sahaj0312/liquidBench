{%- assign embed_id = section.settings.embed_id | default: '' | strip -%}
{%- assign heading = section.settings.heading | default: '' | strip -%}
{%- assign duration = section.settings.duration_seconds | default: 0 -%}
{%- assign start = section.settings.start_seconds | default: 0 -%}
{%- assign query = '' -%}
{%- if start > 0 -%}
  {%- if duration <= 0 or start < duration -%}
    {%- assign query = '?t=' | append: start -%}
  {%- endif -%}
{%- endif -%}
{%- assign duration_text = '' -%}
{%- if duration > 0 -%}
  {%- assign hours = duration | divided_by: 3600 -%}
  {%- assign minutes = duration | modulo: 3600 | divided_by: 60 -%}
  {%- assign seconds = duration | modulo: 60 -%}
  {%- assign ss = seconds | prepend: '0' | slice: -2, 2 -%}
  {%- if hours > 0 -%}
    {%- assign mm = minutes | prepend: '0' | slice: -2, 2 -%}
    {%- assign duration_text = hours | append: ':' | append: mm | append: ':' | append: ss -%}
  {%- else -%}
    {%- assign duration_text = minutes | append: ':' | append: ss -%}
  {%- endif -%}
{%- endif -%}
{%- if embed_id != '' -%}
<div class="podcast-embed">
{%- if heading != '' -%}<h2 class="podcast-embed__heading">{{ heading | escape }}</h2>{%- endif -%}
<iframe class="podcast-embed__player" src="https://player.example.com/e/{{ embed_id | escape }}{{ query }}" title="{{ heading | default: 'Podcast player' | escape }}"></iframe>
{%- if duration_text != '' -%}<p class="podcast-embed__duration">Duration: {{ duration_text }}</p>{%- endif -%}
</div>
{%- endif -%}
{% schema %}
{"name":"Podcast embed","settings":[{"type":"text","id":"embed_id","label":"Episode embed ID"},{"type":"text","id":"heading","label":"Heading"},{"type":"number","id":"duration_seconds","label":"Duration (seconds)"},{"type":"number","id":"start_seconds","label":"Start at (seconds)"}],"presets":[{"name":"Podcast embed"}]}
{% endschema %}
