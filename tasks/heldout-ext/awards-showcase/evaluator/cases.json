[
  {
    "id": "schema-contract",
    "path": "sections/awards-showcase.liquid",
    "body": "<div class=\"awards\" style=\"--columns: {{ section.settings.columns }}; --gap: {{ section.settings.gap }}px; --logo-width: {{ section.settings.logo_width }}px;\">\n  {%- if section.settings.heading != blank -%}\n    <h2 class=\"awards__heading\">{{ section.settings.heading | escape }}</h2>\n  {%- endif -%}\n  <ul class=\"awards__list\">\n    {%- for block in section.blocks -%}\n      <li class=\"awards__item\" {{ block.shopify_attributes }}>\n        <span class=\"awards__title\">{{ block.settings.title | escape }}</span>\n        {%- if block.settings.issuer != blank -%}<span class=\"awards__issuer\">{{ block.settings.issuer | escape }}</span>{%- endif -%}\n        {%- if block.settings.year -%}<span class=\"awards__year\">{{ block.settings.year }}</span>{%- endif -%}\n      </li>\n    {%- endfor -%}\n  </ul>\n</div>\n\n\n",
    "expected": {
      "name": "Awards",
      "tag": "section",
      "class": "section-awards",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Awards & recognition"
        },
        {
          "type": "range",
          "id": "columns",
          "label": "Columns",
          "min": 1,
          "max": 6,
          "step": 1,
          "default": 3
        },
        {
          "type": "range",
          "id": "logo_width",
          "label": "Logo width",
          "min": 40,
          "max": 200,
          "step": 8,
          "unit": "px",
          "default": 96
        },
        {
          "type": "range",
          "id": "gap",
          "label": "Gap",
          "min": 0,
          "max": 100,
          "step": 4,
          "unit": "px",
          "default": 28
        }
      ],
      "blocks": [
        {
          "type": "award",
          "name": "Award",
          "settings": [
            {
              "type": "text",
              "id": "title",
              "label": "Award title",
              "default": "Best in show"
            },
            {
              "type": "text",
              "id": "issuer",
              "label": "Issuer"
            },
            {
              "type": "number",
              "id": "year",
              "label": "Year"
            }
          ]
        }
      ],
      "max_blocks": 12,
      "presets": [
        {
          "name": "Awards",
          "blocks": [
            {
              "type": "award"
            },
            {
              "type": "award"
            },
            {
              "type": "award"
            }
          ]
        }
      ]
    }
  }
]
