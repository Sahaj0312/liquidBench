<div class="awards" style="--columns: {{ section.settings.columns }}; --gap: {{ section.settings.gap }}px; --logo-width: {{ section.settings.logo_width }}px;">
  {%- if section.settings.heading != blank -%}
    <h2 class="awards__heading">{{ section.settings.heading | escape }}</h2>
  {%- endif -%}
  <ul class="awards__list">
    {%- for block in section.blocks -%}
      <li class="awards__item" {{ block.shopify_attributes }}>
        <span class="awards__title">{{ block.settings.title | escape }}</span>
        {%- if block.settings.issuer != blank -%}<span class="awards__issuer">{{ block.settings.issuer | escape }}</span>{%- endif -%}
        {%- if block.settings.year -%}<span class="awards__year">{{ block.settings.year }}</span>{%- endif -%}
      </li>
    {%- endfor -%}
  </ul>
</div>

{% schema %}
{"name":"Awards","tag":"section","class":"section-awards","settings":[{"type":"text","id":"heading","label":"Heading","default":"Awards & recognition"},{"type":"range","id":"columns","label":"Columns","min":1,"max":6,"step":1,"default":3},{"type":"range","id":"logo_width","label":"Logo width","min":40,"max":200,"step":8,"unit":"px","default":100},{"type":"range","id":"gap","label":"Gap","min":0,"max":100,"step":4,"unit":"px","default":30}],"blocks":[{"type":"award","name":"Award","settings":[{"type":"text","id":"title","label":"Award title","default":"Best in show"},{"type":"text","id":"issuer","label":"Issuer"},{"type":"number","id":"year","label":"Year"}]}],"presets":[{"name":"Awards","blocks":[{"type":"award"}]}]}
{% endschema %}
