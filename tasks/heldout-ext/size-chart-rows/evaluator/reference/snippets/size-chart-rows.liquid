{%- assign rendered = 0 -%}
{%- capture rows_html -%}
{%- for row in size_chart.rows -%}
{%- assign label = row.label | strip -%}
{%- if label != "" -%}
{%- assign rendered = rendered | plus: 1 -%}
{%- assign parity = rendered | modulo: 2 -%}
<tr class="size-chart__row size-chart__row--{% if parity == 1 %}odd{% else %}even{% endif %}"><th scope="row">{{ label | escape }}</th>
{%- assign cells = 0 -%}
{%- assign parts = row.measurements | split: "," -%}
{%- for part in parts -%}
{%- assign value = part | strip -%}
{%- if value != "" -%}
{%- assign cells = cells | plus: 1 -%}
<td>{{ value | escape }}</td>
{%- endif -%}
{%- endfor -%}
{%- if cells == 0 -%}<td class="size-chart__empty">n/a</td>{%- endif -%}
</tr>
{%- endif -%}
{%- endfor -%}
{%- endcapture -%}
{%- if rendered > 0 -%}
{%- assign title = size_chart.title | strip -%}
{%- assign unit = size_chart.unit | strip -%}
<table class="size-chart">
{%- if title != "" -%}<caption>{{ title | escape }}{% if unit != "" %} ({{ unit | escape }}){% endif %}</caption>{%- endif -%}
<tbody>{{ rows_html }}</tbody></table>
{%- endif -%}
