[
  {
    "id": "schema-contract",
    "path": "sections/app-download-panel.liquid",
    "body": "<div class=\"app-download\">\n  <h2 class=\"app-download__heading\">{{ section.settings.heading | escape }}</h2>\n  {%- if section.settings.description != blank -%}\n    <p class=\"app-download__text\">{{ section.settings.description | escape }}</p>\n  {%- endif -%}\n  <div class=\"app-download__badges\">\n    {%- for block in section.blocks limit: 3 -%}\n      {%- if block.settings.store_url == blank -%}{%- continue -%}{%- endif -%}\n      <a class=\"app-download__badge app-download__badge--{{ block.settings.store }}\" href=\"{{ block.settings.store_url }}\" {{ block.shopify_attributes }}>{{ block.settings.label | escape }}</a>\n    {%- endfor -%}\n  </div>\n</div>\n\n\n",
    "expected": {
      "name": "App download",
      "tag": "section",
      "class": "app-download-section",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Get the app"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description"
        }
      ],
      "blocks": [
        {
          "type": "store_badge",
          "name": "Store badge",
          "settings": [
            {
              "type": "select",
              "id": "store",
              "label": "Store",
              "options": [
                {
                  "value": "apple",
                  "label": "App Store"
                },
                {
                  "value": "google",
                  "label": "Google Play"
                }
              ],
              "default": "apple"
            },
            {
              "type": "url",
              "id": "store_url",
              "label": "Store link"
            },
            {
              "type": "text",
              "id": "label",
              "label": "Badge text",
              "default": "Download"
            }
          ]
        }
      ],
      "max_blocks": 3,
      "presets": [
        {
          "name": "App download",
          "blocks": [
            {
              "type": "store_badge",
              "settings": {
                "store": "apple"
              }
            },
            {
              "type": "store_badge",
              "settings": {
                "store": "google"
              }
            }
          ]
        }
      ]
    }
  }
]
