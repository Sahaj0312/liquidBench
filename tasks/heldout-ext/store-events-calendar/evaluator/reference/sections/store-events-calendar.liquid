<div class="events-calendar">
  {%- if section.settings.heading != blank -%}
    <h2 class="events-calendar__heading">{{ section.settings.heading | escape }}</h2>
  {%- endif -%}
  <ol class="events-calendar__list">
    {%- for block in section.blocks limit: section.settings.max_events -%}
      <li class="events-calendar__item{% if forloop.first %} events-calendar__item--first{% endif %}{% if forloop.last %} events-calendar__item--last{% endif %}" {{ block.shopify_attributes }}>
        <span class="events-calendar__date">{{ block.settings.date | escape }}</span>
        <span class="events-calendar__title">{{ block.settings.title | escape }}</span>
      </li>
    {%- endfor -%}
  </ol>
</div>
{% schema %}
{"name":"Events calendar","tag":"section","class":"section-events-calendar","settings":[{"type":"text","id":"heading","label":"Heading","default":"Upcoming events"},{"type":"range","id":"max_events","label":"Maximum events shown","min":1,"max":12,"step":1,"default":6}],"blocks":[{"type":"event","name":"Event","settings":[{"type":"text","id":"title","label":"Event title","default":"Store event"},{"type":"text","id":"date","label":"Date","default":"January 1"}]}],"max_blocks":12,"presets":[{"name":"Events calendar","blocks":[{"type":"event"},{"type":"event"},{"type":"event"}]}]}
{% endschema %}
