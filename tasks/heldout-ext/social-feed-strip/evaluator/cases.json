[
  {
    "id": "schema-contract",
    "path": "sections/social-feed-strip.liquid",
    "body": "<section class=\"social-feed\">\n  {%- if section.settings.heading != blank -%}\n    <h2 class=\"social-feed__heading\">{{ section.settings.heading | escape }}</h2>\n  {%- endif -%}\n  <ul class=\"social-feed__list\">\n    {%- for block in section.blocks -%}\n      <li class=\"social-feed__item{% if forloop.first %} social-feed__item--first{% endif %}{% if forloop.last %} social-feed__item--last{% endif %}\" {{ block.shopify_attributes }}>\n        <a href=\"{{ block.settings.post_url }}\">{{ block.settings.caption | escape }}</a>\n      </li>\n    {%- endfor -%}\n  </ul>\n  {%- if section.settings.show_follow and section.settings.follow_url != blank -%}\n    <a class=\"social-feed__follow\" href=\"{{ section.settings.follow_url }}\">Follow</a>\n  {%- endif -%}\n</section>\n\n\n",
    "expected": {
      "name": "Social feed",
      "tag": "section",
      "class": "social-feed-section",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Follow us"
        },
        {
          "type": "checkbox",
          "id": "show_follow",
          "label": "Show follow link",
          "default": true
        },
        {
          "type": "url",
          "id": "follow_url",
          "label": "Follow link"
        }
      ],
      "blocks": [
        {
          "type": "post",
          "name": "Post",
          "settings": [
            {
              "type": "url",
              "id": "post_url",
              "label": "Post link"
            },
            {
              "type": "text",
              "id": "caption",
              "label": "Caption",
              "default": "New post"
            }
          ]
        }
      ],
      "max_blocks": 8,
      "presets": [
        {
          "name": "Social feed",
          "blocks": [
            {
              "type": "post"
            },
            {
              "type": "post"
            },
            {
              "type": "post"
            }
          ]
        }
      ]
    }
  }
]
