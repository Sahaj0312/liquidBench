<section class="social-feed">
  {%- if section.settings.heading != blank -%}
    <h2 class="social-feed__heading">{{ section.settings.heading | escape }}</h2>
  {%- endif -%}
  <ul class="social-feed__list">
    {%- for block in section.blocks -%}
      <li class="social-feed__item{% if forloop.first %} social-feed__item--first{% endif %}{% if forloop.last %} social-feed__item--last{% endif %}" {{ block.shopify_attributes }}>
        <a href="{{ block.settings.post_url }}">{{ block.settings.caption | escape }}</a>
      </li>
    {%- endfor -%}
  </ul>
  {%- if section.settings.show_follow and section.settings.follow_url != blank -%}
    <a class="social-feed__follow" href="{{ section.settings.follow_url }}">Follow</a>
  {%- endif -%}
</section>

{% schema %}
{"name":"Social feed","settings":[{"type":"text","id":"heading","label":"Heading"}],"blocks":[{"type":"post","name":"Post","settings":[{"type":"text","id":"post_url","label":"Post link"},{"type":"text","id":"caption","label":"Caption"}]}]}
{% endschema %}
