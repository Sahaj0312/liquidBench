{{ 'contact-page.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign name_label = 'contact.form.name' | t
  assign email_label = 'contact.form.email' | t
  assign message_label = 'contact.form.message' | t
  assign optional_label = 'contact.form.optional' | t
-%}
{%- capture fields -%}
  {%- render 'contact-input', field: 'name', type: 'text', label: name_label -%}
  {%- render 'contact-input', field: 'email', type: 'email', label: email_label -%}
  {%- render 'contact-input', field: 'message', type: 'textarea', label: message_label, hint: optional_label -%}
{%- endcapture -%}
<div class="contact-page">
  {%- if show_heading -%}
    <h2 class="contact-page__heading">{{ 'contact.page.heading' | t }}</h2>
  {%- endif -%}
  {%- if wrap_fields -%}
    <fieldset class="contact-page__fields">
      <legend>{{ 'contact.page.legend' | t }}</legend>
      {{- fields -}}
    </fieldset>
  {%- else -%}
    {{- fields -}}
  {%- endif -%}
  <button type="submit" class="contact-page__submit">{{ 'contact.form.submit' | t }}</button>
</div>
