<section class="event-listing">
  {%- if section.settings.heading != blank -%}
    <h2 class="event-listing__heading">{{ section.settings.heading | escape }}</h2>
  {%- endif -%}
  <ul class="event-listing__list">
    {%- for block in section.blocks -%}
      <li class="event-listing__item" {{ block.shopify_attributes }}>
        <h3 title="{{ block.settings.title | escape }}">{{ block.settings.title | escape }}</h3>
        <p class="event-listing__date">{{ block.settings.date_label | escape }}</p>
        {%- if block.settings.link != blank -%}
          <a href="{{ block.settings.link }}" aria-label="{{ block.settings.link_label | escape }}">{{ block.settings.link_label | escape }}</a>
        {%- endif -%}
      </li>
    {%- endfor -%}
  </ul>
</section>

{% schema %}
{
  "name": "Event listing",
  "tag": "section",
  "class": "section-event-listing",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Events & \"Pop-ups\"" }
  ],
  "blocks": [
    {
      "type": "event",
      "name": "Event",
      "settings": [
        { "type": "text", "id": "title", "label": "Event title", "default": "Makers' Market" },
        { "type": "text", "id": "date_label", "label": "Date", "default": "May 4 & 5" },
        { "type": "url", "id": "link", "label": "Event link" },
        { "type": "text", "id": "link_label", "label": "Link label", "default": "Get tickets" }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    { "name": "Event listing", "blocks": [ { "type": "event" }, { "type": "event" } ] }
  ]
}
{% endschema %}
