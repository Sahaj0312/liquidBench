{%- comment -%}Lightbox stylesheet, script and dialog shell. Params: show_header, show_caption{%- endcomment -%}
{{ 'component-lightbox.css' | asset_url | stylesheet_tag }}
<script src="{{ 'lightbox-gallery.js' | asset_url }}" defer="defer"></script>
<div class="lightbox" role="dialog" aria-label="{{ 'sections.lightbox.dialog_label' | t }}">
  {%- if show_header -%}
    <header class="lightbox__header">
      <button type="button" class="lightbox__close" aria-label="{{ 'sections.lightbox.close' | t }}">
        {%- render 'icon-close' -%}
      </button>
    </header>
  {%- endif -%}
  <div class="lightbox__stage"></div>
  {%- if show_caption -%}
    <figcaption class="lightbox__caption">{{ 'sections.lightbox.caption_hint' | t }}</figcaption>
  {%- endif -%}
</div>
