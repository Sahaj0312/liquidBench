<div class="award-list">
{%- if section.settings.heading != nil and section.settings.heading != '' -%}
<h2>{{ section.settings.heading | escape }}</h2>
{%- endif -%}
{%- assign from_year = section.settings.from_year -%}
{%- assign limit = section.settings.limit -%}
{%- assign shown = 0 -%}
{%- assign hidden = 0 -%}
{%- capture items -%}
{%- for block in section.blocks -%}
{%- assign year = block.settings.year -%}
{%- assign included = true -%}
{%- if from_year != nil -%}
{%- if year < from_year -%}{%- assign included = false -%}{%- endif -%}
{%- endif -%}
{%- if included -%}
{%- assign room = false -%}
{%- if limit == 0 -%}{%- assign room = true -%}{%- elsif shown < limit -%}{%- assign room = true -%}{%- endif -%}
{%- if room -%}
{%- assign shown = shown | plus: 1 -%}
{%- assign place = block.settings.place | default: 0 -%}
{%- assign medal = '' -%}
{%- if place == 1 -%}{%- assign medal = 'Gold' -%}
{%- elsif place == 2 -%}{%- assign medal = 'Silver' -%}
{%- elsif place == 3 -%}{%- assign medal = 'Bronze' -%}
{%- elsif place >= 4 and place <= 10 -%}{%- assign medal = 'Finalist' -%}
{%- endif -%}
<li>{%- if medal != '' -%}<span class="medal">{{ medal }}</span> {% endif -%}{{ block.settings.name | escape }} ({{ year }})</li>
{%- else -%}
{%- assign hidden = hidden | plus: 1 -%}
{%- endif -%}
{%- endif -%}
{%- endfor -%}
{%- endcapture -%}
{%- if shown == 0 -%}
<p class="empty">No awards</p>
{%- else -%}
<ul class="awards">{{ items }}</ul>
{%- if hidden > 0 -%}
<p class="more">+{{ hidden }} more</p>
{%- endif -%}
{%- endif -%}
</div>

{% schema %}
{"name":"Award list","settings":[{"type":"text","id":"heading","label":"Heading"},{"type":"number","id":"limit","label":"Maximum awards shown (0 = all)","default":0},{"type":"number","id":"from_year","label":"Earliest year"}],"blocks":[{"type":"award","name":"Award","settings":[{"type":"text","id":"name","label":"Name"},{"type":"number","id":"year","label":"Year","default":2024},{"type":"number","id":"place","label":"Place"}]}],"presets":[{"name":"Award list"}]}
{% endschema %}
