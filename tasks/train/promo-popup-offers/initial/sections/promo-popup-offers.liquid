{%- assign shown = 0 -%}
<div class="promo-popup__dialog" data-delay="{{ section.settings.delay_seconds }}" data-show-once="{{ section.settings.show_once }}">
  {%- if section.settings.heading != blank -%}
    <h2 class="promo-popup__heading">{{ section.settings.heading | escape }}</h2>
  {%- endif -%}
  <ul class="promo-popup__offers">
    {%- for block in section.blocks -%}
      {%- if block.type != 'offer' or block.settings.hidden or block.settings.code == blank -%}{%- continue -%}{%- endif -%}
      {%- if shown >= section.settings.max_offers -%}{%- break -%}{%- endif -%}
      {%- assign shown = shown | plus: 1 -%}
      <li class="promo-popup__offer" {{ block.shopify_attributes }}>
        <strong>{{ block.settings.code | escape }}</strong>
        {%- if block.settings.description != blank -%}<p>{{ block.settings.description | escape }}</p>{%- endif -%}
      </li>
    {%- endfor -%}
  </ul>
  {%- for block in section.blocks -%}
    {%- if block.type == 'note' -%}
      <div class="promo-popup__note" {{ block.shopify_attributes }}>{{ block.settings.text }}</div>
    {%- endif -%}
  {%- endfor -%}
</div>

{% schema %}
{
  "name": "Promo Popup",
  "settings": [
    {"type": "text", "id": "heading", "label": "Heading", "default": "Limited time offer"},
    {"type": "number", "id": "delay_seconds", "label": "Delay before showing", "default": 5},
    {"type": "number", "id": "max_offers", "label": "Maximum offers shown", "default": 3},
    {"type": "checkbox", "id": "show_once", "label": "Show once per session", "default": true}
  ],
  "blocks": [
    {"type": "offer", "name": "Offer", "settings": [
      {"type": "text", "id": "discount_code", "label": "Discount code"},
      {"type": "textarea", "id": "description", "label": "Description"}
    ]}
  ],
  "presets": [
    {"name": "Promo popup"}
  ]
}
{% endschema %}
