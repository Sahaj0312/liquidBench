{%- if product.bundle_excluded or product.tags contains 'gift-card' -%}<span class="bundle bundle--none">Not eligible for bundles</span>{%- elsif product.tags contains 'bundle-3for2' and product.price >= 1000 -%}<span class="bundle bundle--3for2">Buy 3, pay for 2</span>{%- elsif product.tags contains 'bundle-mix' -%}<span class="bundle bundle--mix">Mix &amp; match</span>{%- elsif product.price >= 5000 -%}<span class="bundle bundle--save">Bundle &amp; save 10%</span>{%- endif -%}
