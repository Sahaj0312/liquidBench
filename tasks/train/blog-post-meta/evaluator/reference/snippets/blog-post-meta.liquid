{%- assign author = post.author | strip -%}
{%- assign published = post.published_at | strip -%}
{%- assign shown = 0 -%}
{%- assign extra = 0 -%}
{%- capture tag_items -%}
{%- for tag in post.tags -%}
{%- assign t = tag | strip -%}
{%- if t != "" -%}
{%- if shown < 3 -%}
<li>{{ t | escape }}</li>
{%- assign shown = shown | plus: 1 -%}
{%- else -%}
{%- assign extra = extra | plus: 1 -%}
{%- endif -%}
{%- endif -%}
{%- endfor -%}
{%- if extra > 0 -%}<li class="post-meta__more">+{{ extra }}</li>{%- endif -%}
{%- endcapture -%}
{%- capture inner -%}
{%- if author != "" -%}<span class="post-meta__author">By {{ author | escape }}</span>{%- endif -%}
{%- if published != "" -%}<time class="post-meta__date">{{ published | escape }}</time>{%- endif -%}
{%- if post.comments_count != nil -%}<span class="post-meta__comments">{%- if post.comments_count == 0 -%}No comments{%- elsif post.comments_count == 1 -%}1 comment{%- else -%}{{ post.comments_count }} comments{%- endif -%}</span>{%- endif -%}
{%- if shown > 0 -%}<ul class="post-meta__tags">{{ tag_items }}</ul>{%- endif -%}
{%- endcapture -%}
{%- if inner != "" -%}<div class="post-meta">{{ inner }}</div>{%- endif -%}