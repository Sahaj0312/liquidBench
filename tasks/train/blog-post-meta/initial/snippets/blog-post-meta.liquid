<div class="post-meta">
{%- if post.author -%}<span class="post-meta__author">By {{ post.author }}</span>{%- endif -%}
{%- if post.published_at -%}<time class="post-meta__date">{{ post.published_at }}</time>{%- endif -%}
{%- if post.comments_count -%}<span class="post-meta__comments">{{ post.comments_count }} comments</span>{%- endif -%}
<ul class="post-meta__tags">{%- for tag in post.tags limit: 3 -%}<li>{{ tag }}</li>{%- endfor -%}</ul>
</div>