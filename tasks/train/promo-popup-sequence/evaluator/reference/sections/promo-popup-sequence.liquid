<div class="promo-popup" data-delay="{{ section.settings.delay_seconds }}">
  {%- for block in section.blocks -%}
    <div class="promo-popup__slide{% if forloop.first %} is-first{% endif %}{% if forloop.last %} is-last{% endif %}" {{ block.shopify_attributes }}>
      <h2>{{ block.settings.heading | escape }}</h2>
      <p>{{ block.settings.body | escape }}</p>
      {%- if block.settings.button_label != blank -%}
        <a href="{{ block.settings.button_link | default: '#' }}">{{ block.settings.button_label | escape }}</a>
      {%- endif -%}
    </div>
  {%- endfor -%}
  {%- if section.settings.show_close -%}
    <button type="button">{{ section.settings.close_label | escape }}</button>
  {%- endif -%}
</div>

{% schema %}
{"name":"Promo popup","tag":"section","class":"promo-popup-section","max_blocks":3,"settings":[{"type":"range","id":"delay_seconds","label":"Delay before opening","min":0,"max":30,"step":1,"unit":"s","default":5},{"type":"checkbox","id":"show_close","label":"Show close button","default":true},{"type":"text","id":"close_label","label":"Close button label","default":"Close"}],"blocks":[{"type":"slide","name":"Slide","limit":3,"settings":[{"type":"text","id":"heading","label":"Heading","default":"Limited offer"},{"type":"textarea","id":"body","label":"Body"},{"type":"text","id":"button_label","label":"Button label"},{"type":"url","id":"button_link","label":"Button link"}]}],"presets":[{"name":"Promo popup","blocks":[{"type":"slide","settings":{"heading":"Welcome offer"}},{"type":"slide","settings":{"heading":"Last chance"}}]}]}
{% endschema %}
