{%- assign heading = section.settings.heading | strip -%}
{%- assign email = section.settings.email | strip -%}
{%- assign phone = section.settings.phone | strip -%}
{%- capture hours_items -%}
  {%- for block in section.blocks -%}
    {%- if block.type == "hours" -%}
      {%- assign day = block.settings.day | strip -%}
      {%- if day != "" -%}
        {%- assign time = block.settings.time | strip -%}
        {%- if time == "" -%}
          {%- assign time = "Closed" -%}
        {%- endif -%}
        <li><span>{{ day | escape }}</span> {{ time | escape }}</li>
      {%- endif -%}
    {%- endif -%}
  {%- endfor -%}
{%- endcapture -%}
{%- if heading != "" or email != "" or phone != "" or hours_items != "" -%}
<div class="contact">
  {%- if heading != "" -%}
    <h2>{{ heading | escape }}</h2>
  {%- endif -%}
  {%- if email != "" -%}
    <p class="contact__email"><a href="mailto:{{ email | escape }}">{{ email | escape }}</a></p>
  {%- endif -%}
  {%- if phone != "" -%}
    {%- assign dial = phone | remove: " " | remove: "-" | remove: "(" | remove: ")" | remove: "." -%}
    <p class="contact__phone"><a href="tel:{{ dial | escape }}">{{ phone | escape }}</a></p>
  {%- endif -%}
  {%- if hours_items != "" -%}
    <ul class="contact__hours">{{ hours_items }}</ul>
  {%- endif -%}
</div>
{%- endif -%}
{% schema %}
{
  "name": "Contact",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Contact us" },
    { "type": "text", "id": "email", "label": "Email" },
    { "type": "text", "id": "phone", "label": "Phone" }
  ],
  "blocks": [
    {
      "type": "hours",
      "name": "Opening hours",
      "settings": [
        { "type": "text", "id": "day", "label": "Day" },
        { "type": "text", "id": "time", "label": "Time" }
      ]
    },
    {
      "type": "holiday",
      "name": "Holiday hours",
      "settings": [
        { "type": "text", "id": "day", "label": "Day" },
        { "type": "text", "id": "time", "label": "Time" }
      ]
    }
  ],
  "presets": [{ "name": "Contact" }]
}
{% endschema %}
