[
  {
    "id": "schema-contract",
    "path": "sections/custom-liquid-block.liquid",
    "body": "{%- liquid\n  assign pt = section.settings.padding_top\n  assign pb = section.settings.padding_bottom\n  assign wrapper_class = 'custom-liquid custom-liquid--' | append: section.settings.background\n  if section.settings.full_width\n    assign wrapper_class = wrapper_class | append: ' custom-liquid--full'\n  endif\n-%}\n<div class=\"{{ wrapper_class }}\" style=\"padding-top: {{ pt }}px; padding-bottom: {{ pb }}px;\">\n  {{ section.settings.custom_liquid }}\n</div>\n\n\n",
    "expected": {
      "name": "Custom Liquid",
      "tag": "section",
      "class": "section-custom-liquid",
      "disabled_on": {
        "groups": [
          "header",
          "footer"
        ]
      },
      "settings": [
        {
          "type": "liquid",
          "id": "custom_liquid",
          "label": "Custom Liquid",
          "info": "Add app snippets or other Liquid code to create advanced customizations."
        },
        {
          "type": "checkbox",
          "id": "full_width",
          "label": "Full page width",
          "default": false
        },
        {
          "type": "select",
          "id": "background",
          "label": "Background",
          "options": [
            {
              "value": "none",
              "label": "None"
            },
            {
              "value": "light",
              "label": "Light"
            },
            {
              "value": "dark",
              "label": "Dark"
            }
          ],
          "default": "none"
        },
        {
          "type": "header",
          "content": "Section padding"
        },
        {
          "type": "range",
          "id": "padding_top",
          "label": "Top padding",
          "min": 0,
          "max": 120,
          "step": 8,
          "unit": "px",
          "default": 40
        },
        {
          "type": "range",
          "id": "padding_bottom",
          "label": "Bottom padding",
          "min": 0,
          "max": 120,
          "step": 8,
          "unit": "px",
          "default": 40
        }
      ],
      "presets": [
        {
          "name": "Custom Liquid"
        }
      ]
    }
  }
]
