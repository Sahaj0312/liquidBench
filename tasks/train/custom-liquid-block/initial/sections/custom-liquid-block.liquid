{%- liquid
  assign pt = section.settings.padding_top
  assign pb = section.settings.padding_bottom
  assign wrapper_class = 'custom-liquid custom-liquid--' | append: section.settings.background
  if section.settings.full_width
    assign wrapper_class = wrapper_class | append: ' custom-liquid--full'
  endif
-%}
<div class="{{ wrapper_class }}" style="padding-top: {{ pt }}px; padding-bottom: {{ pb }}px;">
  {{ section.settings.custom_liquid }}
</div>

{% schema %}
{"name":"Custom Liquid","tag":"section","class":"section-custom-liquid","settings":[{"type":"textarea","id":"custom_liquid","label":"Custom Liquid"},{"type":"checkbox","id":"full_width","label":"Full page width","default":"false"},{"type":"select","id":"background","label":"Background","options":[{"value":"none","label":"None"},{"value":"light","label":"Light"},{"value":"dark","label":"Dark"}],"default":"None"},{"type":"range","id":"padding_top","label":"Top padding","min":0,"max":120,"step":7,"unit":"px","default":40},{"type":"range","id":"padding_bottom","label":"Bottom padding","min":0,"max":120,"step":8,"unit":"px","default":40}]}
{% endschema %}
