<div class="post-meta"><h2 class="post-meta__title">{{ article_title | strip | default: "Untitled post" | escape }}</h2><p class="post-meta__byline">By <span class="post-meta__author">{{ author | strip | default: "Staff Writer" | escape }}</span> on <span class="post-meta__date">{{ published | strip | default: "Unscheduled" | escape }}</span></p></div>