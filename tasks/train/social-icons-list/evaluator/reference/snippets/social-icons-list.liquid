{%- comment -%} Renders social media links from theme settings. {%- endcomment -%}
{{ 'component-social-icons.css' | asset_url | stylesheet_tag }}
<div class="social-icons">
  <h2 class="social-icons__heading">{{ 'sections.social_icons.heading' | t }}</h2>
  <ul class="social-icons__list" role="list">
    {%- if settings.social_facebook_link != blank -%}
      <li class="social-icons__item">
        <a href="{{ settings.social_facebook_link }}" class="social-icons__link">
          {%- render 'icon-facebook' -%}
          <span class="visually-hidden">{{ 'sections.social_icons.facebook' | t }}</span>
        </a>
      </li>
    {%- endif -%}
    {%- if settings.social_instagram_link != blank -%}
      <li class="social-icons__item">
        <a href="{{ settings.social_instagram_link }}" class="social-icons__link">
          {%- render 'icon-instagram' -%}
          <span class="visually-hidden">{{ 'sections.social_icons.instagram' | t }}</span>
        </a>
      </li>
    {%- endif -%}
    {%- if settings.social_tiktok_link != blank -%}
      <li class="social-icons__item">
        <a href="{{ settings.social_tiktok_link }}" class="social-icons__link">
          {%- render 'icon-tiktok' -%}
          <span class="visually-hidden">{{ 'sections.social_icons.tiktok' | t }}</span>
        </a>
      </li>
    {%- endif -%}
  </ul>
</div>
