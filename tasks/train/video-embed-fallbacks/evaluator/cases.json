[
  {
    "id": "contract",
    "path": "sections/video-embed-fallbacks.liquid",
    "tags": [
      "div",
      "h2",
      "iframe",
      "p",
      "section"
    ],
    "schema_block": "{% schema %}\n{\"name\":\"Video\",\"tag\":\"section\",\"settings\":[{\"type\":\"text\",\"id\":\"heading\",\"label\":\"Heading\",\"default\":\"Watch the video\"},{\"type\":\"text\",\"id\":\"video_id\",\"label\":\"YouTube video ID\"},{\"type\":\"textarea\",\"id\":\"caption\",\"label\":\"Caption\"},{\"type\":\"checkbox\",\"id\":\"autoplay\",\"label\":\"Autoplay (muted)\",\"default\":false},{\"type\":\"number\",\"id\":\"start_minutes\",\"label\":\"Start at minute\"},{\"type\":\"number\",\"id\":\"start_seconds\",\"label\":\"Start at second\"}],\"presets\":[{\"name\":\"Video\"}]}\n{% endschema %}"
  },
  {
    "id": "case-00",
    "variables": {
      "section": {
        "settings": {
          "heading": "Our Story",
          "video_id": "abc123",
          "caption": "Filmed in 2023",
          "autoplay": false,
          "start_minutes": null,
          "start_seconds": null
        }
      }
    },
    "expected": [
      {
        "tag": "section",
        "attrs": [
          [
            "class",
            "video-section"
          ]
        ],
        "children": [
          {
            "tag": "h2",
