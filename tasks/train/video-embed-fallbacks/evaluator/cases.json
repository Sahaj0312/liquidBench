              [
                "class",
                "video-section__heading"
              ]
            ],
            "children": [],
            "text": "Our Story"
          },
          {
            "tag": "div",
            "attrs": [
              [
                "class",
                "video-section__frame"
              ]
            ],
            "children": [
              {
                "tag": "iframe",
                "attrs": [
                  [
                    "src",
                    "https://www.youtube.com/embed/abc123"
                  ],
                  [
                    "title",
                    "Our Story"
                  ]
                ],
                "children": [],
                "text": ""
              }
            ],
            "text": ""
          },
          {
            "tag": "p",
            "attrs": [
              [
                "class",
                "video-section__caption"
              ]
            ],
            "children": [],
            "text": "Filmed in 2023"
          }
        ],
        "text": ""
      }
    ]
  },
