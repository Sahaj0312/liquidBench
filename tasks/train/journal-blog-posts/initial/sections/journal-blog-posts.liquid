<section class="blog-posts">
  {%- if section.settings.heading != blank -%}
    <h2 class="blog-posts__heading">{{ section.settings.heading | escape }}</h2>
  {%- endif -%}
  <ul class="blog-posts__list blog-posts__list--{{ section.settings.columns }}">
    {%- for article in section.settings.blog.articles limit: section.settings.post_limit -%}
      <li class="blog-posts__item">
        <h3>{{ article.title | escape }}</h3>
        {%- if section.settings.show_date -%}<time>{{ article.published_at | date: '%b %d, %Y' }}</time>{%- endif -%}
        {%- if section.settings.show_author -%}<span>{{ article.author | escape }}</span>{%- endif -%}
      </li>
    {%- endfor -%}
  </ul>
  {%- if section.settings.show_view_all and section.settings.blog != blank -%}
    <a class="button" href="{{ section.settings.blog.url }}">{{ section.settings.view_all_label | escape }}</a>
  {%- endif -%}
</section>

{% schema %}
{"name":"Blog posts","tag":"section","settings":[{"type":"text","id":"heading","label":"Heading"},{"type":"blog","id":"blog","label":"Blog"},{"type":"range","id":"post_limit","label":"Posts to show","min":2,"max":12,"default":15},{"type":"select","id":"columns","label":"Columns","options":[{"value":"2","label":"Two"},{"value":"3","label":"Three"}],"default":3},{"type":"checkbox","id":"show_date","label":"Show date","default":"true"}]}
{% endschema %}
