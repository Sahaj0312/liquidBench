{%- assign video = section.settings.video_url -%}
{%- assign ratio = section.settings.aspect_ratio | default: '16-9' -%}
<div class="video-section page-width">
  {%- if section.settings.heading != blank -%}
    <h2 class="video-section__heading">{{ section.settings.heading | escape }}</h2>
  {%- endif -%}
  <div class="video-section__media video-section__media--{{ ratio }}">
    {%- if video != blank -%}
      {%- liquid
        assign params = 'rel=0'
        if section.settings.autoplay
          assign params = 'autoplay=1&mute=1&rel=0'
        endif
      -%}
      {%- if video.type == 'youtube' -%}
        <iframe src="https://www.youtube.com/embed/{{ video.id }}?{{ params }}" title="{{ section.settings.heading | escape }}" allow="autoplay; encrypted-media" allowfullscreen loading="lazy"></iframe>
      {%- else -%}
        <iframe src="https://player.vimeo.com/video/{{ video.id }}?{{ params }}" title="{{ section.settings.heading | escape }}" allow="autoplay; fullscreen" allowfullscreen loading="lazy"></iframe>
      {%- endif -%}
    {%- elsif section.settings.cover_image != blank -%}
      {{ section.settings.cover_image | image_url: width: 1600 | image_tag: loading: 'lazy' }}
    {%- else -%}
      {{ 'hero-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Video",
  "tag": "section",
  "class": "video-section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Watch the story" },
    { "type": "url", "id": "video_url", "label": "Video URL" },
    { "type": "image_picker", "id": "cover_image", "label": "Cover image" },
    { "type": "checkbox", "id": "autoplay", "label": "Autoplay video", "default": true }
  ]
}
{% endschema %}
