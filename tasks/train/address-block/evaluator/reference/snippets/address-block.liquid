<address class="address-block">{%- if address.company != nil and address.company != "" -%}<strong class="address-block__company">{{ address.company | escape }}</strong>{%- endif -%}<span class="address-block__street">{{ address.street | escape }}</span><span class="address-block__city">{{ address.city | escape }}</span>{%- if address.phone != nil and address.phone != "" -%}<p class="address-block__phone"><a href="tel:{{ address.phone | escape }}">{{ address.phone | escape }}</a></p>{%- endif -%}</address>