[
  {
    "id": "schema-contract",
    "path": "sections/brand-rich-text.liquid",
    "body": "{%- assign previous_type = '' -%}\n<div class=\"rich-text rich-text--{{ section.settings.alignment }}{% if section.settings.full_width %} rich-text--full{% endif %}\">\n  {%- for block in section.blocks -%}\n    {%- if previous_type == 'button' and block.type != 'button' -%}</div>{%- endif -%}\n    {%- if block.type == 'button' and previous_type != 'button' -%}<div class=\"rich-text__buttons\">{%- endif -%}\n    {%- case block.type -%}\n      {%- when 'heading' -%}\n        <h2 class=\"rich-text__heading rich-text__heading--{{ block.settings.size }}\" {{ block.shopify_attributes }}>{{ block.settings.heading | escape }}</h2>\n      {%- when 'text' -%}\n        <div class=\"rich-text__text\" {{ block.shopify_attributes }}>{{ block.settings.text }}</div>\n      {%- when 'button' -%}\n        <a class=\"button{% if block.settings.style_secondary %} button--secondary{% endif %}\" href=\"{{ block.settings.link }}\" {{ block.shopify_attributes }}>{{ block.settings.label | escape }}</a>\n    {%- endcase -%}\n    {%- assign previous_type = block.type -%}\n  {%- endfor -%}\n  {%- if previous_type == 'button' -%}</div>{%- endif -%}\n</div>\n\n\n",
    "expected": {
      "name": "Rich text",
      "tag": "section",
      "class": "section-rich-text",
      "max_blocks": 8,
      "settings": [
        {
          "type": "select",
          "id": "alignment",
          "label": "Content alignment",
          "options": [
            {
              "value": "left",
              "label": "Left"
            },
            {
              "value": "center",
              "label": "Center"
            },
            {
              "value": "right",
              "label": "Right"
            }
          ],
          "default": "center"
        },
        {
          "type": "checkbox",
          "id": "full_width",
          "label": "Full width",
          "default": false
        }
      ],
      "blocks": [
        {
          "type": "heading",
          "name": "Heading",
          "limit": 2,
          "settings": [
            {
              "type": "text",
              "id": "heading",
              "label": "Heading",
              "default": "Talk about your brand"
            },
            {
              "type": "select",
              "id": "size",
              "label": "Size",
              "options": [
                {
                  "value": "small",
                  "label": "Small"
                },
                {
                  "value": "medium",
                  "label": "Medium"
                },
                {
                  "value": "large",
                  "label": "Large"
                }
              ],
              "default": "medium"
            }
          ]
        },
        {
          "type": "text",
          "name": "Text",
          "settings": [
            {
              "type": "richtext",
              "id": "text",
              "label": "Text",
              "default": "<p>Share information about your brand with your customers.</p>"
            }
          ]
        },
        {
          "type": "button",
          "name": "Button",
          "limit": 3,
          "settings": [
            {
              "type": "text",
              "id": "label",
              "label": "Button label",
              "default": "Learn more"
            },
            {
              "type": "url",
              "id": "link",
              "label": "Button link"
            },
            {
              "type": "checkbox",
              "id": "style_secondary",
              "label": "Use outline style",
              "default": false
            }
          ]
        }
      ],
      "presets": [
        {
          "name": "Rich text",
          "blocks": [
            {
              "type": "heading"
            },
            {
              "type": "text"
            },
            {
              "type": "button"
            }
          ]
        }
      ]
    }
  }
]
