{%- assign previous_type = '' -%}
<div class="rich-text rich-text--{{ section.settings.alignment }}{% if section.settings.full_width %} rich-text--full{% endif %}">
  {%- for block in section.blocks -%}
    {%- if previous_type == 'button' and block.type != 'button' -%}</div>{%- endif -%}
    {%- if block.type == 'button' and previous_type != 'button' -%}<div class="rich-text__buttons">{%- endif -%}
    {%- case block.type -%}
      {%- when 'heading' -%}
        <h2 class="rich-text__heading rich-text__heading--{{ block.settings.size }}" {{ block.shopify_attributes }}>{{ block.settings.heading | escape }}</h2>
      {%- when 'text' -%}
        <div class="rich-text__text" {{ block.shopify_attributes }}>{{ block.settings.text }}</div>
      {%- when 'button' -%}
        <a class="button{% if block.settings.style_secondary %} button--secondary{% endif %}" href="{{ block.settings.link }}" {{ block.shopify_attributes }}>{{ block.settings.label | escape }}</a>
    {%- endcase -%}
    {%- assign previous_type = block.type -%}
  {%- endfor -%}
  {%- if previous_type == 'button' -%}</div>{%- endif -%}
</div>

{% schema %}
{"name":"Rich text","tag":"section","class":"section-rich-text","max_blocks":8,"settings":[{"type":"select","id":"alignment","label":"Content alignment","options":[{"value":"left","label":"Left"},{"value":"center","label":"Center"},{"value":"right","label":"Right"}],"default":"center"},{"type":"checkbox","id":"full_width","label":"Full width","default":false}],"blocks":[{"type":"heading","name":"Heading","limit":2,"settings":[{"type":"text","id":"heading","label":"Heading","default":"Talk about your brand"},{"type":"select","id":"size","label":"Size","options":[{"value":"small","label":"Small"},{"value":"medium","label":"Medium"},{"value":"large","label":"Large"}],"default":"medium"}]},{"type":"text","name":"Text","settings":[{"type":"richtext","id":"text","label":"Text","default":"<p>Share information about your brand with your customers.</p>"}]},{"type":"button","name":"Button","limit":3,"settings":[{"type":"text","id":"label","label":"Button label","default":"Learn more"},{"type":"url","id":"link","label":"Button link"},{"type":"checkbox","id":"style_secondary","label":"Use outline style","default":false}]}],"presets":[{"name":"Rich text","blocks":[{"type":"heading"},{"type":"text"},{"type":"button"}]}]}
{% endschema %}
