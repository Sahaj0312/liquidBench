<div class="newsletter newsletter--{{ section.settings.alignment }}">
  {%- if section.settings.heading != blank -%}
    <h2 class="newsletter__heading">{{ section.settings.heading | escape }}</h2>
  {%- endif -%}
  {%- if section.settings.subtext != blank -%}
    <div class="newsletter__text">{{ section.settings.subtext }}</div>
  {%- endif -%}
  <form class="newsletter__form" action="/contact#newsletter" method="post">
    <label for="Email-{{ section.id }}">{{ section.settings.email_label | escape }}</label>
    <input id="Email-{{ section.id }}" type="email" name="contact[email]" placeholder="{{ section.settings.placeholder | escape }}" required>
    <button type="submit">{{ section.settings.button_label | escape }}</button>
  </form>
  {%- for block in section.blocks -%}
    <p class="newsletter__note" {{ block.shopify_attributes }}>{{ block.settings.text | escape }}</p>
  {%- endfor -%}
</div>

{% schema %}
{
  "name": "Newsletter",
  "tag": "section",
  "class": "section-newsletter",
  "max_blocks": 3,
  "settings": [
    {"type": "text", "id": "heading", "label": "Heading", "default": "Get 10% off & free shipping"},
    {"type": "richtext", "id": "subtext", "label": "Text", "default": "<p>New arrivals, restocks & members-only offers.</p>"},
    {"type": "text", "id": "email_label", "label": "Email field label", "default": "Email address"},
    {"type": "text", "id": "placeholder", "label": "Email placeholder", "default": "you@example.com"},
    {"type": "text", "id": "button_label", "label": "Button label", "default": "Sign up"},
    {"type": "select", "id": "alignment", "label": "Alignment", "options": [{"value": "left", "label": "Left"}, {"value": "center", "label": "Center"}], "default": "center"}
  ],
  "blocks": [
    {"type": "note", "name": "Note", "settings": [{"type": "text", "id": "text", "label": "Text", "default": "We'll never share your email."}]}
  ],
  "presets": [{"name": "Newsletter", "blocks": [{"type": "note"}]}]
}
{% endschema %}
