{%- assign heading = section.settings.heading | default: "" -%}
{%- assign email = section.settings.email | default: "" -%}
<div class="contact">
{%- if heading != "" -%}<h2 class="contact__heading">{{ heading | escape }}</h2>{%- endif -%}
{%- if email != "" -%}<p class="contact__email">{{ email | escape }}</p>{%- endif -%}
</div>
{% schema %}
{"name":"Contact","settings":[{"type":"text","id":"heading","label":"Heading","default":"Contact us"},{"type":"text","id":"email","label":"Email"}],"presets":[{"name":"Contact"}]}
{% endschema %}
