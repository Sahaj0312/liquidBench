{%- assign heading = section.settings.heading | strip | default: "Featured collage" -%}
{%- assign layout = "left" -%}
{%- if section.settings.layout == "right" -%}
  {%- assign layout = "right" -%}
{%- endif -%}
<h2 class="collage__heading">{{ heading | escape }}</h2><div class="collage collage--{{ layout }}">
  {%- for block in section.blocks -%}
    {%- assign fallback = "Item " | append: forloop.index -%}
    {%- assign title = block.settings.title | strip | default: fallback -%}
    {%- assign caption = block.settings.caption | strip -%}
    <div class="collage__item"><h3>{{ title | escape }}</h3>
    {%- if caption != "" -%}<p>{{ caption | escape }}</p>{%- endif -%}
    </div>
  {%- else -%}
    <p class="collage__empty">Add blocks to build your collage.</p>
  {%- endfor -%}
</div>

{% schema %}
{
  "name": "Collage",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Featured collage" },
    { "type": "select", "id": "layout", "label": "Layout", "options": [ { "value": "left", "label": "Large item left" }, { "value": "right", "label": "Large item right" } ], "default": "left" }
  ],
  "blocks": [
    { "type": "item", "name": "Item", "settings": [ { "type": "text", "id": "title", "label": "Title" }, { "type": "textarea", "id": "caption", "label": "Caption" } ] }
  ],
  "presets": [ { "name": "Collage" } ]
}
{% endschema %}
