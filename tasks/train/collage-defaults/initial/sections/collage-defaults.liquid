<h2 class="collage__heading">{{ section.settings.heading | escape }}</h2>
<div class="collage collage--{{ section.settings.layout }}">
  {%- for block in section.blocks -%}
    <div class="collage__item"><h3>{{ block.settings.title | escape }}</h3><p>{{ block.settings.caption | escape }}</p></div>
  {%- endfor -%}
</div>

{% schema %}
{
  "name": "Collage",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Featured collage" },
    { "type": "select", "id": "layout", "label": "Layout", "options": [ { "value": "left", "label": "Large item left" }, { "value": "right", "label": "Large item right" } ], "default": "left" }
  ],
  "blocks": [
    { "type": "item", "name": "Item", "settings": [ { "type": "text", "id": "title", "label": "Title" }, { "type": "textarea", "id": "caption", "label": "Caption" } ] }
  ],
  "presets": [ { "name": "Collage" } ]
}
{% endschema %}
