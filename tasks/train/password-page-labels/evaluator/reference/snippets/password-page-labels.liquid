{{ 'section-password.css' | asset_url | stylesheet_tag }}
<div class="password-modal">
  {% render 'icon-padlock' %}
  <h2 class="password-modal__heading">{{ 'general.password_page.login_form_heading' | t }}</h2>
  <form method="post" action="/password" class="password-form">
    <label for="Password">{{ 'general.password_page.login_form_password_label' | t }}</label>
    <input type="password" name="password" id="Password" autocomplete="current-password" placeholder="{{ 'general.password_page.login_form_password_placeholder' | t }}">
    <button type="submit" class="button">{{ 'general.password_page.login_form_submit' | t }}</button>
  </form>
  <p class="password-modal__admin">{{ 'general.password_page.admin_link' | t }}</p>
  {% render 'password-social-links' %}
</div>
