{{ 'password-page.css' | asset_url | stylesheet_tag }}
<div class="password-modal">
  {% render 'icon-lock' %}
  <h2 class="password-modal__heading">{{ 'password.title' | t }}</h2>
  <form method="post" action="/password" class="password-form">
    <label for="Password">{{ 'password.label' | t }}</label>
    <input type="password" name="password" id="Password" autocomplete="current-password" placeholder="{{ 'password.placeholder' | t }}">
    <button type="submit" class="button">{{ 'password.enter' | t }}</button>
  </form>
  <p class="password-modal__admin">{{ 'password.admin_link' | t }}</p>
  {% render 'social-icons' %}
</div>
