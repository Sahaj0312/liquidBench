{{ 'search.css' | asset_url | stylesheet_tag }}
<form action="{{ routes.search_url }}" method="get" role="search" class="search-form">
  {%- if label != blank -%}
    {%- assign search_label = label -%}
  {%- else -%}
    {%- assign search_label = 'search.label' | t -%}
  {%- endif -%}
  <label for="SearchInput">{{ search_label | escape }}</label>
  <input id="SearchInput" type="search" name="q" placeholder="{{ 'general.search.place_holder' | t }}">
  <button type="submit">{{ 'general.search.submit_label' | t }}</button>
  {% render 'search-icon' %}
</form>
