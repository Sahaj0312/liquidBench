{%- assign heading = section.settings.heading | strip -%}
{%- assign max_slides = section.settings.max_slides | default: 3 -%}
{%- assign count = 0 -%}
{%- capture slides -%}
  {%- for block in section.blocks -%}
    {%- assign url = block.settings.image_url | strip -%}
    {%- if url == "" -%}{%- continue -%}{%- endif -%}
    {%- if count >= max_slides -%}{%- break -%}{%- endif -%}
    {%- assign count = count | plus: 1 -%}
    {%- assign caption = block.settings.caption | strip -%}
    <div class="banner__slide" data-index="{{ count }}" data-image="{{ url | escape }}">
    {%- if caption != "" -%}<p>{{ caption | escape }}</p>{%- endif -%}
    </div>
  {%- endfor -%}
{%- endcapture -%}
{%- if count > 0 -%}
  <div class="banner">
  {%- if heading != "" -%}<h2 class="banner__heading">{{ heading | escape }}</h2>{%- endif -%}
  {{- slides -}}
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Image banner",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "range", "id": "max_slides", "label": "Maximum slides", "min": 1, "max": 5, "step": 1, "default": 3 }
  ],
  "blocks": [
    { "type": "slide", "name": "Slide", "settings": [ { "type": "text", "id": "image_url", "label": "Image URL" }, { "type": "text", "id": "caption", "label": "Caption" } ] }
  ],
  "presets": [ { "name": "Image banner" } ]
}
{% endschema %}
