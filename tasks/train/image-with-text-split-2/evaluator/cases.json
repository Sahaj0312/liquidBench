[
  {
    "id": "schema-contract",
    "path": "sections/image-with-text-split-2.liquid",
    "body": "<div class=\"image-with-text image-with-text--{{ section.settings.image_position }}\" style=\"--image-width: {{ section.settings.image_width }}%; --padding-top: {{ section.settings.padding_top }}px;\">\n  <div class=\"image-with-text__media\">\n    {%- if section.settings.image != blank -%}\n      {{ section.settings.image | image_url: width: 1500 | image_tag: loading: 'lazy' }}\n    {%- endif -%}\n  </div>\n  <div class=\"image-with-text__content\">\n    {%- for block in section.blocks -%}\n      {%- case block.type -%}\n        {%- when 'heading' -%}\n          <h2 {{ block.shopify_attributes }}>{{ block.settings.heading | escape }}</h2>\n        {%- when 'text' -%}\n          <div {{ block.shopify_attributes }}>{{ block.settings.text }}</div>\n        {%- when 'button' -%}\n          {%- if block.settings.label != blank -%}\n            <a href=\"{{ block.settings.link }}\" class=\"button\" {{ block.shopify_attributes }}>{{ block.settings.label | escape }}</a>\n          {%- endif -%}\n      {%- endcase -%}\n    {%- endfor -%}\n  </div>\n</div>\n\n\n",
    "expected": {
      "name": "Image with text",
      "tag": "section",
      "class": "section-image-with-text",
      "max_blocks": 5,
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "select",
          "id": "image_position",
          "label": "Image position",
          "options": [
            {
              "value": "left",
              "label": "Left"
            },
            {
              "value": "right",
              "label": "Right"
            }
          ],
          "default": "left"
        },
        {
          "type": "range",
          "id": "image_width",
          "label": "Image width",
          "min": 30,
          "max": 70,
          "step": 5,
          "unit": "%",
          "default": 50
        },
        {
          "type": "range",
          "id": "padding_top",
          "label": "Top padding",
          "min": 0,
          "max": 100,
          "step": 4,
          "unit": "px",
          "default": 36
        }
      ],
      "blocks": [
        {
          "type": "heading",
          "name": "Heading",
          "limit": 1,
          "settings": [
            {
              "type": "text",
              "id": "heading",
              "label": "Heading",
              "default": "Image with text"
            }
          ]
        },
        {
          "type": "text",
          "name": "Text",
          "settings": [
            {
              "type": "richtext",
              "id": "text",
              "label": "Text",
              "default": "<p>Pair text with an image to focus on your chosen product, collection, or blog post.</p>"
            }
          ]
        },
        {
          "type": "button",
          "name": "Button",
          "limit": 2,
          "settings": [
            {
              "type": "text",
              "id": "label",
              "label": "Button label",
              "default": "Learn more"
            },
            {
              "type": "url",
              "id": "link",
              "label": "Button link"
            }
          ]
        }
      ],
      "presets": [
        {
          "name": "Image with text",
          "blocks": [
            {
              "type": "heading"
            },
            {
              "type": "text"
            },
            {
              "type": "button"
            }
          ]
        }
      ]
    }
  }
]
