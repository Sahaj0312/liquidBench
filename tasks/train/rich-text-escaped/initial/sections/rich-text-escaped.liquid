<div class="rich-text"><h2 class="rich-text__heading">{{ section.settings.heading }}</h2><p class="rich-text__body">{{ section.settings.text }}</p></div>
{% schema %}
{
  "name": "Rich text",
  "settings": [
    {"type": "text", "id": "heading", "label": "Heading"},
    {"type": "textarea", "id": "text", "label": "Text"},
    {"type": "text", "id": "button_label", "label": "Button label"},
    {"type": "url", "id": "button_link", "label": "Button link"}
  ],
  "presets": [{"name": "Rich text"}]
}
{% endschema %}
