[
  {
    "id": "contract",
    "path": "sections/rich-text-escaped.liquid",
    "tags": [
      "a",
      "div",
      "h2",
      "p"
    ],
    "schema_block": "{% schema %}\n{\n  \"name\": \"Rich text\",\n  \"settings\": [\n    {\"type\": \"text\", \"id\": \"heading\", \"label\": \"Heading\"},\n    {\"type\": \"textarea\", \"id\": \"text\", \"label\": \"Text\"},\n    {\"type\": \"text\", \"id\": \"button_label\", \"label\": \"Button label\"},\n    {\"type\": \"url\", \"id\": \"button_link\", \"label\": \"Button link\"}\n  ],\n  \"presets\": [{\"name\": \"Rich text\"}]\n}\n{% endschema %}"
  },
  {
    "id": "case-00",
    "variables": {
      "section": {
        "settings": {
          "heading": "Our story",
          "text": "Made by hand.",
          "button_label": "Read more",
          "button_link": "/pages/about"
        }
      }
    },
    "expected": [
      {
        "tag": "div",
        "attrs": [
          [
            "class",
            "rich-text"
          ]
        ],
        "children": [
          {
            "tag": "h2",
            "attrs": [
              [
                "class",
                "rich-text__heading"
              ]
            ],
            "children": [],
            "text": "Our story"
          },
          {
            "tag": "p",
            "attrs": [
              [
                "class",
                "rich-text__body"
              ]
            ],
            "children": [],
            "text": "Made by hand."
          },
          {
            "tag": "a",
            "attrs": [
              [
                "class",
                "rich-text__button"
              ],
              [
                "href",
                "/pages/about"
              ]
            ],
            "children": [],
            "text": "Read more"
          }
        ],
        "text": ""
      }
    ]
  },
