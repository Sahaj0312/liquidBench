<div class="rich-text"><h2 class="rich-text__heading">{{ section.settings.heading | escape }}</h2><p class="rich-text__body">{{ section.settings.text | escape }}</p>{%- if section.settings.button_label and section.settings.button_label != "" and section.settings.button_link and section.settings.button_link != "" -%}<a class="rich-text__button" href="{{ section.settings.button_link | escape }}">{{ section.settings.button_label | escape }}</a>{%- endif -%}</div>
{% schema %}
{
  "name": "Rich text",
  "settings": [
    {"type": "text", "id": "heading", "label": "Heading"},
    {"type": "textarea", "id": "text", "label": "Text"},
    {"type": "text", "id": "button_label", "label": "Button label"},
    {"type": "url", "id": "button_link", "label": "Button link"}
  ],
  "presets": [{"name": "Rich text"}]
}
{% endschema %}
