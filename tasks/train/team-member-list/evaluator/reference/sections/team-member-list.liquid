<div class="team">
  {%- assign heading = section.settings.heading | strip -%}
  {%- if heading != "" -%}
    <h2 class="team__heading">{{ heading | escape }}</h2>
  {%- endif -%}
  <ul class="team__list">
    {%- for block in section.blocks -%}
      {%- assign role = block.settings.role | strip -%}
      <li class="team__member"><span class="team__name">{{ block.settings.name | escape }}</span>
        {%- if role != "" -%}
          <span class="team__role">{{ role | escape }}</span>
        {%- endif -%}
      </li>
    {%- endfor -%}
  </ul></div>

{% schema %}
{
  "name": "Team members",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Meet the team" }
  ],
  "blocks": [
    {
      "type": "member",
      "name": "Team member",
      "settings": [
        { "type": "text", "id": "name", "label": "Name" },
        { "type": "text", "id": "role", "label": "Role" }
      ]
    }
  ],
  "presets": [{ "name": "Team members" }]
}
{% endschema %}
