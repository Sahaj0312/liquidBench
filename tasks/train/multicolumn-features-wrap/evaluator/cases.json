          "id": "button_label",
          "label": "Button label"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Button link"
        }
      ],
      "blocks": [
        {
          "type": "column",
          "name": "Column",
          "settings": [
            {
              "type": "image_picker",
              "id": "image",
