{%- liquid
  assign groups = ''
  assign g_first = ''
  assign g_last = ''
  assign g_time = ''
  assign g_count = 0
  for block in section.blocks
    assign opens = block.settings.opens
    assign closes = block.settings.closes
    assign time = 'Closed'
    if opens != nil and closes != nil and closes > opens
      assign time = ''
      assign pair = opens | append: ',' | append: closes | split: ','
      for raw in pair
        assign m = raw | plus: 0
        assign h = m | divided_by: 60
        assign mm = m | modulo: 60
        if mm < 10
          assign mm = mm | prepend: '0'
        endif
        if h == 0
          assign h12 = 12
          assign suffix = 'AM'
        elsif h < 12
          assign h12 = h
          assign suffix = 'AM'
        elsif h == 12
          assign h12 = 12
          assign suffix = 'PM'
        else
          assign h12 = h | minus: 12
          assign suffix = 'PM'
        endif
        unless forloop.first
          assign time = time | append: ' - '
        endunless
        assign time = time | append: h12 | append: ':' | append: mm | append: ' ' | append: suffix
      endfor
    endif
    assign day = block.settings.day | escape
    if g_count > 0 and time == g_time
      assign g_last = day
      assign g_count = g_count | plus: 1
    else
      if g_count > 0
        assign days = g_first
        if g_count > 1
          assign days = g_first | append: '-' | append: g_last
        endif
        assign groups = groups | append: '<li><span class="store-info__days">' | append: days | append: '</span> <span class="store-info__time">' | append: g_time | append: '</span></li>'
      endif
      assign g_first = day
      assign g_last = day
      assign g_time = time
      assign g_count = 1
    endif
  endfor
  if g_count > 0
    assign days = g_first
    if g_count > 1
      assign days = g_first | append: '-' | append: g_last
    endif
    assign groups = groups | append: '<li><span class="store-info__days">' | append: days | append: '</span> <span class="store-info__time">' | append: g_time | append: '</span></li>'
  endif
-%}
<div class="store-info"><h2 class="store-info__name">{{ section.settings.store_name | escape }}</h2><p class="store-info__address">{{ section.settings.address | escape }}</p>
{%- if groups != '' -%}<ul class="store-info__hours">{{ groups }}</ul>{%- endif -%}
</div>
{% schema %}
{
  "name": "Store info",
  "settings": [
    { "type": "text", "id": "store_name", "label": "Store name" },
    { "type": "text", "id": "address", "label": "Address" }
  ],
  "blocks": [
    {
      "type": "hours",
      "name": "Opening hours",
      "settings": [
        { "type": "text", "id": "day", "label": "Day", "default": "Mon" },
        { "type": "number", "id": "opens", "label": "Opens (minutes after midnight)" },
        { "type": "number", "id": "closes", "label": "Closes (minutes after midnight)" }
      ]
    }
  ],
  "presets": [{ "name": "Store info" }]
}
{% endschema %}
