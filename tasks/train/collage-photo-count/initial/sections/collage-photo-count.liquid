{%- assign heading = section.settings.heading | default: "" -%}
<section class="collage">
{%- if heading != "" -%}<h2 class="collage__heading">{{ heading | escape }}</h2>{%- endif -%}
{%- if images.size > 0 -%}<ul class="collage__grid">
{%- for image in images -%}<li class="collage__item">{{ image.caption | escape }}</li>{%- endfor -%}
</ul>{%- endif -%}
</section>
{% schema %}
{"name":"Collage","settings":[{"type":"text","id":"heading","label":"Heading","default":"Collage"}],"presets":[{"name":"Collage"}]}
{% endschema %}
