{%- assign max = section.settings.max_items -%}
<div class="rich-text-columns">
  {%- if section.settings.heading != blank -%}
    <h2>{{ section.settings.heading | escape }}</h2>
  {%- endif -%}
  {%- for block in section.blocks limit: max -%}
    {%- if block.settings.text == blank -%}{%- continue -%}{%- endif -%}
    <div class="rich-text-columns__item" {{ block.shopify_attributes }}>{{ block.settings.text }}</div>
  {%- endfor -%}
</div>

{% schema %}
{"name":"Rich text columns","tag":"section","class":"rich-text-columns-section","settings":[{"type":"text","id":"heading","label":"Heading","default":"Highlights"},{"type":"range","id":"max_items","label":"Maximum columns","min":1,"max":6,"step":1,"default":3}],"blocks":[{"type":"column","name":"Column","settings":[{"type":"richtext","id":"text","label":"Text","default":"<p>Column text</p>"}]}],"max_blocks":6,"presets":[{"name":"Rich text columns","blocks":[{"type":"column"},{"type":"column"},{"type":"column"}]}]}
{% endschema %}
