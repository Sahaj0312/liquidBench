  {
    "id": "schema-contract",
    "path": "sections/rich-text-columns.liquid",
    "body": "{%- assign max = section.settings.max_items -%}\n<div class=\"rich-text-columns\">\n  {%- if section.settings.heading != blank -%}\n    <h2>{{ section.settings.heading | escape }}</h2>\n  {%- endif -%}\n  {%- for block in section.blocks limit: max -%}\n    {%- if block.settings.text == blank -%}{%- continue -%}{%- endif -%}\n    <div class=\"rich-text-columns__item\" {{ block.shopify_attributes }}>{{ block.settings.text }}</div>\n  {%- endfor -%}\n</div>\n\n\n",
