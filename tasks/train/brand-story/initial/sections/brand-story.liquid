<div class="brand-story brand-story--image-{{ section.settings.image_position }}">
  {%- if section.settings.image != blank -%}
    <div class="brand-story__media">
      {{ section.settings.image | image_url: width: 900 | image_tag: loading: 'lazy' }}
    </div>
  {%- endif -%}
  <div class="brand-story__content">
    {%- if section.settings.eyebrow != blank -%}
      <p class="brand-story__eyebrow">{{ section.settings.eyebrow | escape }}</p>
    {%- endif -%}
    <h2 class="brand-story__heading">{{ section.settings.heading | escape }}</h2>
    <div class="rte">{{ section.settings.story }}</div>
    {%- if section.settings.button_link != blank and section.settings.button_label != blank -%}
      <a class="button" href="{{ section.settings.button_link }}">{{ section.settings.button_label | escape }}</a>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": " Brand story ",
  "tag": "section",
  "class": "brand-story ",
  "settings": [
    {"type": "text", "id": "eyebrow", "label": "Eyebrow ", "default": " Since 1998"},
    {"type": "text", "id": " heading", "label": "Heading", "default": "  Our story  "},
    {"type": "richtext", "id": "story", "label": "Story", "default": "<p> We started in a small workshop. </p>"},
    {"type": "image_picker", "id": "image", "label": " Image"},
    {"type": "select", "id": "image_position ", "label": "Image position", "options": [{"value": "left", "label": "Left"}, {"value": " right", "label": "Right "}], "default": "left"},
    {"type": "url", "id": "button_link", "label": "Button link"},
    {"type": "text", "id": "button_label ", "label": "Button label", "default": "Read more "}
  ],
  "presets": [
    {"name": "Brand story "}
  ]
}
{% endschema %}
