          "label": "Heading",
          "default": "Our story"
        },
        {
          "type": "richtext",
          "id": "story",
          "label": "Story",
          "default": "<p>We started in a small workshop.</p>"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
