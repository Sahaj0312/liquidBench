[
  {
    "id": "schema-contract",
    "path": "sections/brand-story.liquid",
    "body": "<div class=\"brand-story brand-story--image-{{ section.settings.image_position }}\">\n  {%- if section.settings.image != blank -%}\n    <div class=\"brand-story__media\">\n      {{ section.settings.image | image_url: width: 900 | image_tag: loading: 'lazy' }}\n    </div>\n  {%- endif -%}\n  <div class=\"brand-story__content\">\n    {%- if section.settings.eyebrow != blank -%}\n      <p class=\"brand-story__eyebrow\">{{ section.settings.eyebrow | escape }}</p>\n    {%- endif -%}\n    <h2 class=\"brand-story__heading\">{{ section.settings.heading | escape }}</h2>\n    <div class=\"rte\">{{ section.settings.story }}</div>\n    {%- if section.settings.button_link != blank and section.settings.button_label != blank -%}\n      <a class=\"button\" href=\"{{ section.settings.button_link }}\">{{ section.settings.button_label | escape }}</a>\n    {%- endif -%}\n  </div>\n</div>\n\n\n",
    "expected": {
      "name": "Brand story",
      "tag": "section",
      "class": "brand-story",
      "settings": [
        {
          "type": "text",
          "id": "eyebrow",
          "label": "Eyebrow",
          "default": "Since 1998"
        },
        {
          "type": "text",
