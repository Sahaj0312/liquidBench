{%- assign heading = section.settings.heading | strip -%}
{%- assign shown = 0 -%}
{%- capture items -%}
  {%- for block in section.blocks -%}
    {%- assign title = block.settings.title | strip -%}
    {%- assign text = block.settings.text | strip -%}
    {%- if title != "" or text != "" -%}
      {%- if shown < section.settings.columns_limit -%}
        {%- assign shown = shown | plus: 1 -%}
        <li class="multicolumn__item">
          {%- if title != "" -%}<h3 class="multicolumn__title">{{ title | escape }}</h3>{%- endif -%}
          {%- if text != "" -%}<p class="multicolumn__text">{{ text | escape }}</p>{%- endif -%}
        </li>
      {%- endif -%}
    {%- endif -%}
  {%- endfor -%}
{%- endcapture -%}
{%- if shown > 0 -%}
  {%- if heading != "" -%}<h2 class="multicolumn__heading">{{ heading | escape }}</h2>{%- endif -%}
  <ul class="multicolumn__list" data-columns="{{ shown }}">{{ items }}</ul>
{%- endif -%}
{% schema %}
{
  "name": "Multicolumn",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Why shop with us" },
    { "type": "range", "id": "columns_limit", "label": "Maximum columns", "min": 1, "max": 6, "step": 1, "default": 3 }
  ],
  "blocks": [
    {
      "type": "column",
      "name": "Column",
      "settings": [
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "textarea", "id": "text", "label": "Text" }
      ]
    }
  ],
  "presets": [{ "name": "Multicolumn" }]
}
{% endschema %}
