{%- assign heading_text = "" -%}
{%- for block in section.blocks -%}
  {%- if block.type == "heading" and heading_text == "" -%}
    {%- assign heading_text = block.settings.text | strip -%}
  {%- endif -%}
{%- endfor -%}
{%- capture heading_html -%}
  {%- if heading_text != "" -%}<h2 class="newsletter__heading">{{ heading_text | escape }}</h2>{%- endif -%}
{%- endcapture -%}
{%- if newsletter_status == "success" -%}
  {%- assign message = section.settings.success_message | strip | default: "Thanks for subscribing!" -%}
  <div class="newsletter newsletter--success">{{ heading_html }}<p class="newsletter__success">{{ message | escape }}</p></div>
{%- else -%}
  {%- assign label = section.settings.button_label | strip | default: "Subscribe" -%}
  <div class="newsletter">{{ heading_html }}
  {%- for block in section.blocks -%}
    {%- if block.type == "paragraph" -%}
      {%- assign para = block.settings.text | strip -%}
      {%- if para != "" -%}<p class="newsletter__text">{{ para | escape }}</p>{%- endif -%}
    {%- endif -%}
  {%- endfor -%}
  {%- if newsletter_status == "error" -%}
    {%- assign error_text = section.settings.error_message | strip | default: "Please enter a valid email address." -%}
    <p class="newsletter__error" role="alert">{{ error_text | escape }}</p>
  {%- endif -%}
  <form class="newsletter__form" method="post" action="/contact#newsletter"><button type="submit" class="newsletter__button">{{ label | escape }}</button></form></div>
{%- endif -%}
{% schema %}
{
  "name": "Newsletter",
  "settings": [
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Subscribe" },
    { "type": "text", "id": "success_message", "label": "Success message", "default": "Thanks for subscribing!" },
    { "type": "text", "id": "error_message", "label": "Error message" }
  ],
  "blocks": [
    { "type": "heading", "name": "Heading", "settings": [{ "type": "text", "id": "text", "label": "Text" }] },
    { "type": "paragraph", "name": "Paragraph", "settings": [{ "type": "textarea", "id": "text", "label": "Text" }] }
  ],
  "presets": [{ "name": "Newsletter" }]
}
{% endschema %}
