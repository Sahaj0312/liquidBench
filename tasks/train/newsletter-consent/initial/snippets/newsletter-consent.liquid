{% assign addr = email | strip %}
{% if addr != "" %}
  {% assign status = consent_status | strip | downcase %}
  <div class="consent consent--{{ status }}">
    <p class="consent__email">{{ addr | escape }</p>
    {% case status %}
      {% when "granted" %}
        <p class="consent__msg">Subscribed</p>
        <ul class="consent__lists">
          {% for name in lists %}
            <li>{{ name }}</li>
        </ul>
      {% when "pending" %}
        <p class="consent__msg">Awaiting confirmation</p>
      {% elsif status == "revoked" %}
        <p class="consent__msg">Unsubscribed</p>
    {% endcase %}
  </div>
{% endif %}
