{%- assign total = 0 -%}
{%- for block in section.blocks -%}
  {%- if block.type == 'perk' -%}
    {%- assign perk_text = block.settings.text | strip -%}
    {%- if perk_text != '' -%}
      {%- assign total = total | plus: 1 -%}
    {%- endif -%}
  {%- endif -%}
{%- endfor -%}
{%- assign sentence = '' -%}
{%- assign n = 0 -%}
{%- for block in section.blocks -%}
  {%- if block.type == 'perk' -%}
    {%- assign perk_text = block.settings.text | strip -%}
    {%- if perk_text != '' -%}
      {%- assign n = n | plus: 1 -%}
      {%- if n > 1 -%}
        {%- if n == total -%}
          {%- assign sentence = sentence | append: ' and ' -%}
        {%- else -%}
          {%- assign sentence = sentence | append: ', ' -%}
        {%- endif -%}
      {%- endif -%}
      {%- assign perk_html = perk_text | escape | prepend: '<strong>' | append: '</strong>' -%}
      {%- assign sentence = sentence | append: perk_html -%}
    {%- endif -%}
  {%- endif -%}
{%- endfor -%}
<div class="newsletter">
{%- if section.settings.title != nil and section.settings.title != '' -%}
<h2 class="newsletter__title">{{ section.settings.title | escape }}</h2>
{%- endif -%}
{%- if total > 0 -%}
<p class="newsletter__perks">Subscribe and get {{ sentence }}.</p>
{%- endif -%}
<button class="newsletter__button" type="submit">{{ section.settings.button_label | default: 'Subscribe' | escape }}</button></div>
{% schema %}
{
  "name": "Newsletter",
  "settings": [
    { "type": "text", "id": "title", "label": "Title", "default": "Join our newsletter" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Subscribe" }
  ],
  "blocks": [
    { "type": "perk", "name": "Perk", "settings": [{ "type": "text", "id": "text", "label": "Text" }] },
    { "type": "note", "name": "Note", "settings": [{ "type": "text", "id": "text", "label": "Text" }] }
  ],
  "max_blocks": 8,
  "presets": [{ "name": "Newsletter" }]
}
{% endschema %}
