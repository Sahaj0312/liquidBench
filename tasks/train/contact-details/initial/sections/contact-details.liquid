<div class="contact"><h2 class="contact__heading">{{ section.settings.heading | escape }}</h2><ul class="contact__list"><li class="contact__email"><a href="mailto:{{ section.settings.email }}">{{ section.settings.email }}</a></li><li class="contact__phone">{{ section.settings.phone }}</li><li class="contact__address">{{ section.settings.address }}</li></ul></div>
{% schema %}
{
  "name": "Contact",
  "settings": [
    {"type": "text", "id": "heading", "label": "Heading", "default": "Contact us"},
    {"type": "text", "id": "email", "label": "Email"},
    {"type": "text", "id": "phone", "label": "Phone"},
    {"type": "textarea", "id": "address", "label": "Address"}
  ],
  "presets": [{"name": "Contact"}]
}
{% endschema %}
