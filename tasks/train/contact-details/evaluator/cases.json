[
  {
    "id": "contract",
    "path": "sections/contact-details.liquid",
    "tags": [
      "a",
      "div",
      "h2",
      "li",
      "ul"
    ],
    "schema_block": "{% schema %}\n{\n  \"name\": \"Contact\",\n  \"settings\": [\n    {\"type\": \"text\", \"id\": \"heading\", \"label\": \"Heading\", \"default\": \"Contact us\"},\n    {\"type\": \"text\", \"id\": \"email\", \"label\": \"Email\"},\n    {\"type\": \"text\", \"id\": \"phone\", \"label\": \"Phone\"},\n    {\"type\": \"textarea\", \"id\": \"address\", \"label\": \"Address\"}\n  ],\n  \"presets\": [{\"name\": \"Contact\"}]\n}\n{% endschema %}"
  },
  {
    "id": "case-00",
    "variables": {
      "section": {
        "settings": {
          "heading": "Get in touch",
          "email": "hello@shop.test",
          "phone": "+1 555 0100",
          "address": "1 Main St"
        }
      }
    },
    "expected": [
      {
        "tag": "div",
        "attrs": [
          [
            "class",
            "contact"
          ]
        ],
        "children": [
          {
            "tag": "h2",
            "attrs": [
              [
                "class",
                "contact__heading"
              ]
            ],
            "children": [],
            "text": "Get in touch"
          },
          {
            "tag": "ul",
            "attrs": [
              [
                "class",
                "contact__list"
              ]
            ],
            "children": [
              {
                "tag": "li",
                "attrs": [
                  [
                    "class",
                    "contact__email"
                  ]
                ],
                "children": [
                  {
                    "tag": "a",
                    "attrs": [
                      [
                        "href",
                        "mailto:hello@shop.test"
                      ]
                    ],
                    "children": [],
                    "text": "hello@shop.test"
                  }
                ],
                "text": ""
              },
              {
                "tag": "li",
                "attrs": [
                  [
                    "class",
                    "contact__phone"
                  ]
                ],
                "children": [],
                "text": "+1 555 0100"
              },
              {
                "tag": "li",
                "attrs": [
                  [
                    "class",
                    "contact__address"
                  ]
                ],
                "children": [],
                "text": "1 Main St"
              }
            ],
            "text": ""
          }
        ],
        "text": ""
      }
    ]
  },
