[
  {
    "id": "schema-contract",
    "path": "sections/blog-posts-grid.liquid",
    "body": "<div class=\"blog-posts page-width\" style=\"padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;\">\n  {%- if section.settings.heading != blank -%}\n    <h2 class=\"blog-posts__heading\">{{ section.settings.heading | escape }}</h2>\n  {%- endif -%}\n  {%- assign blog = section.settings.blog -%}\n  {%- if blog != blank and blog.articles_count > 0 -%}\n    <ul class=\"blog-posts__grid blog-posts__grid--{{ section.settings.columns_desktop }}-col\" role=\"list\">\n      {%- for article in blog.articles limit: section.settings.post_limit -%}\n        <li class=\"blog-posts__card blog-posts__card--{{ section.settings.image_ratio }}\">\n          {%- if section.settings.show_image and article.image -%}\n            {{ article.image | image_url: width: 800 | image_tag: loading: 'lazy', class: 'blog-posts__image' }}\n          {%- endif -%}\n          <h3 class=\"blog-posts__title\"><a href=\"{{ article.url }}\">{{ article.title | escape }}</a></h3>\n          {%- if section.settings.show_date -%}\n            <span class=\"blog-posts__date\">{{ article.published_at | time_tag: format: 'date' }}</span>\n          {%- endif -%}\n          {%- if section.settings.show_author -%}\n            <span class=\"blog-posts__author\">{{ article.author | escape }}</span>\n          {%- endif -%}\n        </li>\n      {%- endfor -%}\n    </ul>\n  {%- else -%}\n    <p class=\"blog-posts__empty\">No posts yet.</p>\n  {%- endif -%}\n</div>\n\n\n",
    "expected": {
      "name": "Blog posts",
      "tag": "section",
      "class": "section-blog-posts",
      "disabled_on": {
        "groups": [
          "header",
          "footer"
        ]
      },
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Blog posts"
        },
        {
          "type": "blog",
          "id": "blog",
          "label": "Blog"
        },
        {
          "type": "range",
          "id": "post_limit",
          "min": 2,
          "max": 12,
          "step": 1,
          "label": "Number of posts",
          "default": 3
        },
        {
          "type": "range",
          "id": "columns_desktop",
          "min": 1,
          "max": 4,
          "step": 1,
          "label": "Columns on desktop",
          "default": 3
        },
        {
          "type": "header",
          "content": "Post card"
        },
        {
          "type": "checkbox",
          "id": "show_image",
          "label": "Show featured image",
          "default": true
        },
        {
          "type": "select",
          "id": "image_ratio",
          "label": "Image ratio",
          "options": [
            {
              "value": "adapt",
              "label": "Adapt to image"
            },
            {
              "value": "square",
              "label": "Square"
            },
            {
              "value": "portrait",
              "label": "Portrait"
            }
          ],
          "default": "adapt"
        },
        {
          "type": "checkbox",
          "id": "show_date",
          "label": "Show date",
          "default": true
        },
        {
          "type": "checkbox",
          "id": "show_author",
          "label": "Show author",
          "default": false
        },
        {
          "type": "header",
          "content": "Section padding"
        },
        {
          "type": "range",
          "id": "padding_top",
          "min": 0,
          "max": 100,
          "step": 4,
          "unit": "px",
          "label": "Top padding",
          "default": 36
        },
        {
          "type": "range",
          "id": "padding_bottom",
          "min": 0,
          "max": 100,
          "step": 4,
          "unit": "px",
          "label": "Bottom padding",
          "default": 36
        }
      ],
      "presets": [
        {
          "name": "Blog posts"
        }
      ]
    }
  }
]
