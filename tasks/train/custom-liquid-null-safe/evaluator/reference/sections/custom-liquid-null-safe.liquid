{%- liquid
  assign heading = section.settings.heading
  assign code = section.settings.custom_liquid
-%}
{%- if heading != blank or code != blank -%}
<div class="custom-liquid-section custom-liquid-section--{{ section.settings.spacing }}">
  {%- if heading != blank -%}
    <h2 class="custom-liquid-section__heading">{{ heading | escape }}</h2>
  {%- endif -%}
  {%- if code != blank -%}
    <div class="custom-liquid-section__content">{{ code }}</div>
  {%- endif -%}
</div>
{%- endif -%}

{% schema %}
{
  "name": "Custom Liquid",
  "tag": "section",
  "class": "section",
  "settings": [
    {"type": "text", "id": "heading", "label": "Heading", "info": "Leave empty to hide the heading"},
    {"type": "liquid", "id": "custom_liquid", "label": "Custom Liquid", "info": "Add app snippets or other Liquid code"},
    {"type": "select", "id": "spacing", "label": "Vertical spacing", "options": [{"value": "none", "label": "None"}, {"value": "small", "label": "Small"}, {"value": "large", "label": "Large"}], "default": "small"}
  ],
  "presets": [{"name": "Custom Liquid"}]
}
{% endschema %}
