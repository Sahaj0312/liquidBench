{{ 'newsletter.css' | asset_url | stylesheet_tag }}
<div class="newsletter">
  <h2 class="newsletter__heading">{{ 'newsletter.heading' | t }}</h2>
  <form method="post" action="/contact#newsletter" class="newsletter__form">
    <input type="hidden" name="contact[tags]" value="newsletter">
    <label for="NewsletterEmail" class="newsletter__label">{{ 'newsletter.form.email' | t }}</label>
    <input type="email" id="NewsletterEmail" name="contact[email]" placeholder="{{ 'newsletter.form.email' | t }}" required>
    <button type="submit" class="newsletter__button">
      {{ 'newsletter.form.subscribe' | t }}
      {% render 'arrow-icon' %}
    </button>
  </form>
</div>
