{%- if section.settings.enable_bar -%}
<div class="announcement-bar announcement-bar--{{ section.settings.alignment }}" style="background-color: {{ section.settings.bar_color }}; color: {{ section.settings.text_color }};" role="region">
  {%- for block in section.blocks -%}
    {%- case block.type -%}
      {%- when 'message' -%}
        <p class="announcement-bar__message" {{ block.shopify_attributes }}>
          {%- if block.settings.link != blank -%}
            <a href="{{ block.settings.link }}">{{ block.settings.text | escape }}</a>
          {%- else -%}
            {{ block.settings.text | escape }}
          {%- endif -%}
        </p>
      {%- when 'promo_code' -%}
        <p class="announcement-bar__promo" {{ block.shopify_attributes }}>{{ block.settings.caption | escape }} <strong>{{ block.settings.code | escape }}</strong></p>
    {%- endcase -%}
  {%- endfor -%}
</div>
{%- endif -%}
{% schema %}
{"name":"Announcement bar","tag":"aside","class":"announcement-bar-section","max_blocks":3,"settings":[{"type":"checkbox","id":"enable_bar","label":"Show announcement bar","default":true},{"type":"select","id":"alignment","label":"Text alignment","options":[{"value":"left","label":"Left"},{"value":"center","label":"Center"},{"value":"right","label":"Right"}],"default":"center"},{"type":"color","id":"bar_color","label":"Bar color","default":"#121212"},{"type":"color","id":"text_color","label":"Text color","default":"#FFFFFF"}],"blocks":[{"type":"message","name":"Message","settings":[{"type":"text","id":"text","label":"Message text","default":"Free shipping on orders over $50"},{"type":"url","id":"link","label":"Link"}]},{"type":"promo_code","name":"Promo code","limit":1,"settings":[{"type":"text","id":"caption","label":"Caption","default":"Use code"},{"type":"text","id":"code","label":"Code","default":"WELCOME10"}]}],"presets":[{"name":"Announcement bar","blocks":[{"type":"message"},{"type":"promo_code"}]}]}
{% endschema %}
