[
  {
    "id": "schema-contract",
    "path": "sections/announcement-bar-case.liquid",
    "body": "{%- if section.settings.enable_bar -%}\n<div class=\"announcement-bar announcement-bar--{{ section.settings.alignment }}\" style=\"background-color: {{ section.settings.bar_color }}; color: {{ section.settings.text_color }};\" role=\"region\">\n  {%- for block in section.blocks -%}\n    {%- case block.type -%}\n      {%- when 'message' -%}\n        <p class=\"announcement-bar__message\" {{ block.shopify_attributes }}>\n          {%- if block.settings.link != blank -%}\n            <a href=\"{{ block.settings.link }}\">{{ block.settings.text | escape }}</a>\n          {%- else -%}\n            {{ block.settings.text | escape }}\n          {%- endif -%}\n        </p>\n      {%- when 'promo_code' -%}\n        <p class=\"announcement-bar__promo\" {{ block.shopify_attributes }}>{{ block.settings.caption | escape }} <strong>{{ block.settings.code | escape }}</strong></p>\n    {%- endcase -%}\n  {%- endfor -%}\n</div>\n{%- endif -%}\n\n",
    "expected": {
      "name": "Announcement bar",
      "tag": "aside",
      "class": "announcement-bar-section",
      "max_blocks": 3,
      "settings": [
        {
          "type": "checkbox",
          "id": "enable_bar",
          "label": "Show announcement bar",
          "default": true
        },
        {
          "type": "select",
          "id": "alignment",
          "label": "Text alignment",
          "options": [
            {
              "value": "left",
              "label": "Left"
            },
            {
              "value": "center",
              "label": "Center"
            },
            {
              "value": "right",
              "label": "Right"
            }
          ],
          "default": "center"
        },
        {
          "type": "color",
          "id": "bar_color",
          "label": "Bar color",
          "default": "#121212"
        },
        {
          "type": "color",
          "id": "text_color",
          "label": "Text color",
          "default": "#FFFFFF"
        }
      ],
      "blocks": [
        {
          "type": "message",
          "name": "Message",
          "settings": [
            {
              "type": "text",
              "id": "text",
              "label": "Message text",
              "default": "Free shipping on orders over $50"
            },
            {
              "type": "url",
              "id": "link",
              "label": "Link"
            }
          ]
        },
        {
          "type": "promo_code",
          "name": "Promo code",
          "limit": 1,
          "settings": [
            {
              "type": "text",
              "id": "caption",
              "label": "Caption",
              "default": "Use code"
            },
            {
              "type": "text",
              "id": "code",
              "label": "Code",
              "default": "WELCOME10"
            }
          ]
        }
      ],
      "presets": [
        {
          "name": "Announcement bar",
          "blocks": [
            {
              "type": "message"
            },
            {
              "type": "promo_code"
            }
          ]
        }
      ]
    }
  }
]
