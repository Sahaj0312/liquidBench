[
  {
    "id": "schema-contract",
    "path": "sections/logo-list-strip.liquid",
    "body": "<div class=\"logo-list logo-list--{{ section.settings.layout }}\" style=\"--logos-per-row: {{ section.settings.logos_per_row }};\">\n  {%- if section.settings.heading != blank -%}\n    <h2 class=\"logo-list__heading\">{{ section.settings.heading | escape }}</h2>\n  {%- endif -%}\n  <ul class=\"logo-list__items\">\n    {%- for block in section.blocks -%}\n      <li class=\"logo-list__item\" {{ block.shopify_attributes }}>\n        {%- if block.settings.image != blank -%}\n          {%- capture logo -%}{{ block.settings.image | image_url: width: 300 | image_tag: alt: block.settings.alt_text, loading: 'lazy' }}{%- endcapture -%}\n        {%- else -%}\n          {%- capture logo -%}{{ 'logo' | placeholder_svg_tag: 'logo-list__placeholder' }}{%- endcapture -%}\n        {%- endif -%}\n        {%- if block.settings.link != blank -%}\n          <a href=\"{{ block.settings.link }}\">{{ logo }}</a>\n        {%- else -%}\n          {{ logo }}\n        {%- endif -%}\n      </li>\n    {%- endfor -%}\n  </ul>\n</div>\n\n\n",
    "expected": {
      "name": "Logo list",
      "tag": "section",
      "class": "section-logo-list",
      "max_blocks": 12,
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Trusted by"
        },
        {
          "type": "select",
          "id": "layout",
          "label": "Layout",
          "options": [
            {
              "value": "grid",
              "label": "Grid"
            },
            {
              "value": "carousel",
              "label": "Carousel"
            }
          ],
          "default": "grid"
        },
        {
          "type": "range",
          "id": "logos_per_row",
          "label": "Logos per row",
          "min": 2,
          "max": 6,
          "step": 1,
          "default": 4
        }
      ],
      "blocks": [
        {
          "type": "logo",
          "name": "Logo",
          "settings": [
            {
              "type": "image_picker",
              "id": "image",
              "label": "Image"
            },
            {
              "type": "text",
              "id": "alt_text",
              "label": "Alt text"
            },
            {
              "type": "url",
              "id": "link",
              "label": "Link"
            }
          ]
        }
      ],
      "presets": [
        {
          "name": "Logo list",
          "blocks": [
            {
              "type": "logo"
            },
            {
              "type": "logo"
            },
            {
              "type": "logo"
            },
            {
              "type": "logo"
            }
          ]
        }
      ]
    }
  }
]
