{%- if section.settings.video_url != blank -%}
<div class="featured-video" data-autoplay="{{ section.settings.autoplay }}">
  {%- if section.settings.heading != blank -%}
  <h2 class="featured-video__heading">{{ section.settings.heading | escape }}</h2>
  {%- endif -%}
  <iframe src="{{ section.settings.video_url }}" title="{{ section.settings.heading | default: 'Video' | escape }}" allowfullscreen></iframe>
</div>
{%- endif -%}

{% schema %}
{
  "name": "Video",
  "tag": "section",
  "class": "section-video",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Featured video" },
    { "type": "video_url", "id": "video_url", "label": "Video URL", "accept": ["youtube", "vimeo"], "info": "Leave empty to hide the section." },
    { "type": "checkbox", "id": "autoplay", "label": "Autoplay", "default": false }
  ],
  "presets": [{ "name": "Video" }]
}
{% endschema %}
