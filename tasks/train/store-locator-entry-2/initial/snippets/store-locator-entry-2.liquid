<article class="store-entry">
<h4 class="store-entry__name">{{ store.name }}</h4>
<address class="store-entry__address"><span>{{ store.address_line1 }}</span><span>{{ store.address_line2 }}</span><span>{{ store.postal_code }} {{ store.city }}</span></address>
<p class="store-entry__phone"><a href="tel:{{ store.phone }}">{{ store.phone }}</a></p>
<p class="store-entry__distance">{{ store.distance_km }} km away</p>
</article>
