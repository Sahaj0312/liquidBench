    "id": "case-00",
    "variables": {
      "section": {
        "settings": {
          "message": "Free shipping over $50",
          "tone": "sale"
        }
      }
    },
    "expected": [
      {
        "tag": "div",
        "attrs": [
          [
            "class",
            "promo-strip promo-strip--sale"
          ]
        ],
        "children": [
          {
            "tag": "p",
            "attrs": [
              [
                "class",
                "promo-strip__message"
              ]
            ],
            "children": [],
            "text": "Free shipping over $50"
          }
        ],
        "text": ""
      }
    ]
  },
