    "schema_block": "{% schema %}\n{\n  \"name\": \"Promo strip\",\n  \"settings\": [\n    {\"type\": \"text\", \"id\": \"message\", \"label\": \"Message\"},\n    {\n      \"type\": \"select\",\n      \"id\": \"tone\",\n      \"label\": \"Tone\",\n      \"options\": [\n        {\"value\": \"info\", \"label\": \"Info\"},\n        {\"value\": \"sale\", \"label\": \"Sale\"},\n        {\"value\": \"warning\", \"label\": \"Warning\"}\n      ],\n      \"default\": \"info\"\n    }\n  ],\n  \"presets\": [{\"name\": \"Promo strip\"}]\n}\n{% endschema %}"
  },
