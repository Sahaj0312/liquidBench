<div class="team-list">
  <h2 class="team__heading">{{ section.settings.heading }}</h2>
  <ul class="team">
    {%- for block in section.blocks -%}
      <li class="team__member">
        <a class="team__link" href="{{ block.settings.profile_url }}">{{ block.settings.name }}</a>
        <p class="team__role">{{ block.settings.role }}</p>
      </li>
    {%- endfor -%}
  </ul>
</div>
{% schema %}
{
  "name": "Team members",
  "settings": [{"type": "text", "id": "heading", "label": "Heading"}],
  "blocks": [{"type": "member", "name": "Member", "settings": [{"type": "text", "id": "name", "label": "Name"}, {"type": "text", "id": "role", "label": "Role"}, {"type": "url", "id": "profile_url", "label": "Profile URL"}]}],
  "presets": [{"name": "Team members"}]
}
{% endschema %}
