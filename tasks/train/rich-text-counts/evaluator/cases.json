[
  {
    "id": "schema-contract",
    "path": "sections/rich-text-counts.liquid",
    "body": "<div class=\"rich-text-counts\" style=\"--columns: {{ section.settings.columns }};\">\n  {%- if section.settings.heading != blank -%}\n    <h2 class=\"rich-text-counts__heading\">{{ section.settings.heading | escape }}</h2>\n  {%- endif -%}\n  {%- if section.settings.text != blank -%}\n    <div class=\"rich-text-counts__text\">{{ section.settings.text }}</div>\n  {%- endif -%}\n  {%- if section.settings.show_total -%}\n    {%- assign total = section.blocks.size -%}\n    <p class=\"rich-text-counts__total\">{{ total }} {% if total == 1 %}{{ section.settings.total_label_one | escape }}{% else %}{{ section.settings.total_label_other | escape }}{% endif %}</p>\n  {%- endif -%}\n  <ul class=\"rich-text-counts__list\">\n    {%- for block in section.blocks -%}\n      {%- assign n = block.settings.count | default: 0 -%}\n      <li {{ block.shopify_attributes }}>\n        <span class=\"rich-text-counts__number\">{{ n }}</span>\n        <span class=\"rich-text-counts__label\">{% if n == 1 %}{{ block.settings.label_one | escape }}{% else %}{{ block.settings.label_other | escape }}{% endif %}</span>\n      </li>\n    {%- endfor -%}\n  </ul>\n</div>\n\n\n",
    "expected": {
      "name": "Rich text counts",
      "tag": "section",
      "class": "rich-text-counts-section",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "By the numbers"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>Our story in figures.</p>"
        },
        {
          "type": "range",
          "id": "columns",
          "label": "Columns",
          "min": 1,
          "max": 4,
          "step": 1,
          "default": 3
        },
        {
          "type": "checkbox",
          "id": "show_total",
          "label": "Show total",
          "default": true
        },
        {
          "type": "text",
          "id": "total_label_one",
          "label": "Total label (one)",
          "default": "fact"
        },
        {
          "type": "text",
          "id": "total_label_other",
          "label": "Total label (other)",
          "default": "facts"
        }
      ],
      "blocks": [
        {
          "type": "stat",
          "name": "Stat",
          "settings": [
            {
              "type": "number",
              "id": "count",
              "label": "Count",
              "default": 1
            },
            {
              "type": "text",
              "id": "label_one",
              "label": "Label (one)",
              "default": "customer"
            },
            {
              "type": "text",
              "id": "label_other",
              "label": "Label (other)",
              "default": "customers"
            }
          ]
        }
      ],
      "max_blocks": 4,
      "presets": [
        {
          "name": "Rich text counts",
          "blocks": [
            {
              "type": "stat"
            },
            {
              "type": "stat",
              "settings": {
                "count": 12,
                "label_one": "country",
                "label_other": "countries"
              }
            }
          ]
        }
      ]
    }
  }
]
