<section data-id="{{ section.id | escape }}"><h2>{{ section.settings.heading | escape }}</h2><p>{{ body | escape }}</p>{% assign url = section.settings.url | default: "" | strip %}{% if section.settings.show_link and url != empty %}<a href="{{ url | escape }}">{{ section.settings.label | default: "Details" | escape }}</a>{% endif %}</section>
{% schema %}
{
  "name": "Panel",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Panel"
    },
    {
      "type": "checkbox",
      "id": "show_link",
      "label": "Show link",
      "default": true
    },
    {
      "type": "url",
      "id": "url",
      "label": "URL"
    },
    {
      "type": "text",
      "id": "label",
      "label": "Label",
      "default": "Details"
    }
  ],
  "presets": [
    {
      "name": "Panel"
    }
  ]
}
{% endschema %}