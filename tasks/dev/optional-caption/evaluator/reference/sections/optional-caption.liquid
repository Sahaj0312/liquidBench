<section data-id="{{ section.id | escape }}"><h2>{{ section.settings.heading | escape }}</h2>{% if section.settings.show_caption %}{% assign caption = section.settings.caption | default: "" | strip %}{% if caption != empty %}<p class="caption">{{ caption | escape }}</p>{% endif %}{% endif %}<p class="footer">{{ footer | escape }}</p></section>
{% schema %}
{
  "name": "Panel",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Panel"
    },
    {
      "type": "checkbox",
      "id": "show_caption",
      "label": "Caption enabled",
      "default": false
    },
    {
      "type": "text",
      "id": "caption",
      "label": "Caption",
      "default": "Caption"
    }
  ],
  "presets": [
    {
      "name": "Panel"
    }
  ]
}
{% endschema %}