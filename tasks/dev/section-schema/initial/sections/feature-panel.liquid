<div class="feature-panel">
  <h2>{{ section.settings.heading | escape }}</h2>
  {% if section.settings.show_summary %}<p>Built for daily use.</p>{% endif %}
</div>
{% schema %}
{
  "name": "Feature panel",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Highlights"
    },
    {
      "type": "checkbox",
      "id": "heading",
      "label": "Show summary",
      "default": "yes"
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Columns",
      "min": 1,
      "max": 4,
      "step": 1,
      "default": 7
    }
  ],
  "presets": [
    {
      "name": "Feature panel",
      "settings": {
        "heading": "Featured picks",
        "show_summry": true,
        "columns": 7
      }
    }
  ]
}
{% endschema %}
