[
  {
    "id": "schema-contract",
    "schema": {
      "name": "Feature panel",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Highlights"
        },
        {
          "type": "checkbox",
          "id": "show_summary",
          "label": "Show summary",
          "default": true
        },
        {
          "type": "range",
          "id": "columns",
          "label": "Columns",
          "min": 1,
          "max": 4,
          "step": 1,
          "default": 3
        }
      ],
      "presets": [
        {
          "name": "Feature panel",
          "settings": {
            "heading": "Featured picks",
            "show_summary": false,
            "columns": 2
          }
        }
      ]
    },
    "body": "<div class=\"feature-panel\">\n  <h2>{{ section.settings.heading | escape }}</h2>\n  {% if section.settings.show_summary %}<p>Built for daily use.</p>{% endif %}\n</div>\n\n"
  }
]
