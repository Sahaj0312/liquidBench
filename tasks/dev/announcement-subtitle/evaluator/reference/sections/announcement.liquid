{% if section.settings.enabled %}
<section class="announcement" data-section-id="{{ section.id | escape }}">
  <h2>{{ section.settings.heading | escape }}</h2>
  {% assign subtitle = section.settings.subtitle | default: '' | strip %}
  {% if subtitle != empty %}<p class="announcement__subtitle">{{ subtitle | escape }}</p>{% endif %}
  {% if section.settings.show_body %}<p class="announcement__body">{{ section.settings.body | escape }}</p>{% endif %}
</section>
{% endif %}
{% schema %}
{
  "name": "Announcement",
  "settings": [
    {
      "type": "checkbox",
      "id": "enabled",
      "label": "Enabled",
      "default": true
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Updates"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Latest news"
    },
    {
      "type": "checkbox",
      "id": "show_body",
      "label": "Show body",
      "default": false
    },
    {
      "type": "text",
      "id": "body",
      "label": "Body",
      "default": "From the studio"
    }
  ],
  "presets": [
    {
      "name": "Announcement"
    }
  ]
}
{% endschema %}
