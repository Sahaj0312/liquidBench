{% assign count = 0 %}{% capture entries %}{% for row in rows %}{% if row.show %}{% if count >= section.settings.limit %}{% break %}{% endif %}<li>{{ row.label | escape }}</li>{% assign count = count | plus: 1 %}{% endif %}{% endfor %}{% endcapture %}<section data-id="{{ section.id | escape }}"><h2>{{ section.settings.heading | escape }}</h2>{% if count == 0 %}<p class="empty">No entries</p>{% else %}<ul>{{ entries }}</ul>{% endif %}</section>
{% schema %}
{
  "name": "Panel",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Panel"
    },
    {
      "type": "range",
      "id": "limit",
      "label": "Limit",
      "min": 1,
      "max": 3,
      "step": 1,
      "default": 2
    }
  ],
  "presets": [
    {
      "name": "Panel"
    }
  ]
}
{% endschema %}