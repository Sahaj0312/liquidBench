<section data-id="{{ section.id | escape }}"><h2>{{ section.settings.heading | escape }}</h2><ul>{% for row in rows %}<li>{{ row.label | escape }}</li>{% endfor %}</ul></section>
{% schema %}
{
  "name": "Panel",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Panel"
    },
    {
      "type": "range",
      "id": "limit",
      "label": "Limit",
      "min": 1,
      "max": 3,
      "step": 1,
      "default": 2
    }
  ],
  "presets": [
    {
      "name": "Panel"
    }
  ]
}
{% endschema %}