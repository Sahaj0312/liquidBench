<section class="footer-schema"><h2>Footer</h2></section>
{% schema %}
{
  "name": "Footer",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu",
      "default": "footer"
    },
    {
      "type": "checkbox",
      "id": "show_payment",
      "label": "Show payment icons",
      "default": "true"
    },
    {
      "type": "text",
      "id": "copyright",
      "label": "Copyright"
    }
  ]
}
{% endschema %}
