<section data-id="{{ section.id | escape }}"><h2>{{ section.settings.heading | escape }}</h2>{% assign shown = 0 %}{% for faq in faqs %}{% assign question = faq.question | default: "" | strip %}{% if question != empty %}<details{% if shown == 0 %} open{% endif %}><summary>{{ question | escape }}</summary><p>{{ faq.answer | escape }}</p></details>{% assign shown = shown | plus: 1 %}{% endif %}{% endfor %}{% if shown == 0 %}<p class="empty">No questions yet</p>{% endif %}</section>
{% schema %}
{
  "name": "Panel",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "FAQ"
    }
  ],
  "presets": [
    {
      "name": "Panel"
    }
  ]
}
{% endschema %}