<section data-id="{{ section.id | escape }}"><h2>{{ section.settings.heading | escape }}</h2>{% for faq in faqs %}<p>{{ faq.question }}</p><p>{{ faq.answer }}</p>{% endfor %}</section>
{% schema %}
{
  "name": "Panel",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "FAQ"
    }
  ],
  "presets": [
    {
      "name": "Panel"
    }
  ]
}
{% endschema %}