<section class="color-scheme-schema"><h2>Colors</h2></section>
{% schema %}
{
  "name": "Colors",
  "settings": [
    {
      "type": "color",
      "id": "background",
      "label": "Background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text",
      "label": "Text",
      "default": "#111111"
    },
    {
      "type": "checkbox",
      "id": "gradient",
      "label": "Use gradient",
      "default": "false"
    }
  ],
  "presets": [
    {
      "name": "Colors"
    }
  ]
}
{% endschema %}
