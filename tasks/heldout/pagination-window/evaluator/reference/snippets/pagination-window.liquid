{% if paginate.pages > 1 %}{% assign win_start = paginate.current | minus: 2 %}{% if win_start < 1 %}{% assign win_start = 1 %}{% endif %}{% assign win_end = paginate.current | plus: 2 %}{% if win_end > paginate.pages %}{% assign win_end = paginate.pages %}{% endif %}<nav class="pagination">{% if paginate.current > 1 %}<a class="prev" href="?page={{ paginate.current | minus: 1 }}">Previous</a>{% endif %}{% for n in (win_start..win_end) %}{% if n == paginate.current %}<span class="current">{{ n }}</span>{% else %}<a href="?page={{ n }}">{{ n }}</a>{% endif %}{% endfor %}{% if paginate.current < paginate.pages %}<a class="next" href="?page={{ paginate.current | plus: 1 }}">Next</a>{% endif %}</nav>{% endif %}