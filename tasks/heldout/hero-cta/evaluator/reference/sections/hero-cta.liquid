<section class="hero" data-id="{{ section.id | escape }}"><h2>{{ section.settings.heading | escape }}</h2>{% assign label = section.settings.cta_label | default: "" | strip %}{% assign url = section.settings.cta_url | default: "" | strip %}{% if label != empty and url != empty %}<a class="button" href="{{ url | escape }}">{{ label | escape }}</a>{% endif %}</section>
{% schema %}
{
  "name": "Panel",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Hero"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button label"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "Button link"
    }
  ],
  "presets": [
    {
      "name": "Panel"
    }
  ]
}
{% endschema %}