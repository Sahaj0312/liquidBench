{% assign columns = section.settings.columns %}{% if columns < 1 %}{% assign columns = 1 %}{% endif %}{% if columns > 4 %}{% assign columns = 4 %}{% endif %}<section data-id="{{ section.id | escape }}">{% if items.size == 0 %}<p class="empty">Nothing here</p>{% else %}<ul class="grid" data-columns="{{ columns }}">{% for item in items %}<li>{{ item | escape }}</li>{% endfor %}</ul>{% endif %}</section>
{% schema %}
{
  "name": "Panel",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Grid"
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Columns",
      "min": 1,
      "max": 4,
      "step": 1,
      "default": 3
    }
  ],
  "presets": [
    {
      "name": "Panel"
    }
  ]
}
{% endschema %}