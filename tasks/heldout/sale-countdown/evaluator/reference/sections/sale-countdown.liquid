<section data-id="{{ section.id | escape }}">{% if section.settings.ends_at > now %}<p class="message">{{ section.settings.message | escape }}</p>{% assign remaining = section.settings.ends_at | minus: now %}{% assign hours = remaining | divided_by: 3600 %}{% assign minutes = remaining | modulo: 3600 | divided_by: 60 %}<p class="countdown">Ends in {{ hours }}h {{ minutes }}m</p>{% else %}<p class="message">Sale ended</p>{% endif %}</section>
{% schema %}
{
  "name": "Panel",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Countdown"
    },
    {
      "type": "text",
      "id": "message",
      "label": "Message"
    },
    {
      "type": "number",
      "id": "ends_at",
      "label": "Ends at (Unix seconds)"
    }
  ],
  "presets": [
    {
      "name": "Panel"
    }
  ]
}
{% endschema %}