<section data-id="{{ section.id | escape }}"><p class="message">{{ section.settings.message | escape }}</p></section>
{% schema %}
{
  "name": "Panel",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Countdown"
    },
    {
      "type": "text",
      "id": "message",
      "label": "Message"
    },
    {
      "type": "number",
      "id": "ends_at",
      "label": "Ends at (Unix seconds)"
    }
  ],
  "presets": [
    {
      "name": "Panel"
    }
  ]
}
{% endschema %}